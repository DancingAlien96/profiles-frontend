# URL publica de la API en Render, sin barra final.
# La copias del panel de Render cuando el servicio este desplegado.
PUBLIC_API_URL=https://perfiles-api.onrender.com

# Dominio final del sitio. Se usa para las etiquetas Open Graph (las vistas
# previas de WhatsApp y LinkedIn).
# En Netlify es OPCIONAL: si no la defines se usa la variable URL que Netlify
# inyecta sola. Defínela solo cuando conectes un dominio propio.
SITE_URL=https://tu-sitio.netlify.app
