# Dominio publico del sitio. Se usa en las etiquetas Open Graph, o sea en las
# vistas previas de WhatsApp: si esta mal, los enlaces se comparten sin foto.
SITE_URL=https://www.professionalprofiles.online

# API interna. El sitio corre en el mismo VPS, asi que va por localhost y no
# sale a internet. Debe coincidir con PORT del .env de la API.
API_INTERNA=http://127.0.0.1:5000

# Direccion de la API para el NAVEGADOR del cliente (panel de edicion, alta,
# administracion). Vacio = mismo dominio, que es lo recomendado: Nginx manda
# /api al backend y asi no hay CORS. Solo se rellena si la API vive en otro
# dominio.
PUBLIC_API_URL=

# Donde se guardan las fotos y vistas previas ya generadas, para no rehacerlas
# en cada visita.
CACHE_DIR=/var/lib/perfiles-web/cache

# Nginx hace de proxy hacia este puerto en localhost.
HOST=127.0.0.1
PORT=4321
