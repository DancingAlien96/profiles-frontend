# Servicio systemd para el sitio de las tarjetas.
#
#   sudo cp deploy/perfiles-web.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now perfiles-web
#   sudo systemctl status perfiles-web

[Unit]
Description=Sitio de tarjetas digitales (Astro SSR)
After=network-online.target perfiles-api.service
Wants=network-online.target

[Service]
Type=simple
User=deploy
WorkingDirectory=/var/www/perfiles-web
ExecStart=/usr/bin/node dist/server/entry.mjs
EnvironmentFile=/var/www/perfiles-web/.env
Restart=always
RestartSec=5

Environment=NODE_ENV=production

# Endurecimiento basico
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

# Unico sitio donde escribe: la cache de imagenes generadas.
#   sudo mkdir -p /var/lib/perfiles-web/cache
#   sudo chown deploy:deploy /var/lib/perfiles-web/cache
ReadWritePaths=/var/lib/perfiles-web

StandardOutput=journal
StandardError=journal
SyslogIdentifier=perfiles-web

[Install]
WantedBy=multi-user.target
