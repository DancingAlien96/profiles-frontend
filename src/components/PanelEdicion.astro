---
/**
 * Boton discreto + panel de edicion.
 *
 * Todo ocurre en el navegador del dueño contra la API del VPS. La pagina
 * publica que ve cualquier visitante es HTML estatico y no ejecuta nada de
 * esto hasta que alguien pulsa el boton.
 */
import { TEMAS } from '../lib/temas.js';
import { TIPOS_ENLACE } from '../lib/enlaces.js';

const { perfil } = Astro.props;
// Vacio = mismo dominio: Nginx manda /api al backend, asi que el navegador
// llama a rutas relativas y no hay CORS que configurar. Solo hace falta poner
// la URL completa si algun dia la API vive en otro dominio.
const API_URL = (import.meta.env.PUBLIC_API_URL || '').replace(/\/$/, '');
const tipos = Object.entries(TIPOS_ENLACE);

// Solo lo imprescindible para arrancar el panel. `mustChangePassword` queda
// fuera a proposito: incrustarlo en el HTML publico delataria que perfiles
// siguen usando la clave inicial, que es la adivinable. El valor real llega
// en la respuesta del login.
const semilla = { slug: perfil.slug, hasPhoto: perfil.hasPhoto };
---

<button class="editar-btn" id="abrir-editor" title="Editar mi perfil" aria-label="Editar mi perfil">
  <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M12 20h9M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4Z"></path>
  </svg>
</button>

<div class="ed-overlay" id="ed-overlay" hidden>
  <div class="ed-modal" role="dialog" aria-modal="true" aria-labelledby="ed-titulo">
    <button class="ed-cerrar" id="ed-cerrar" aria-label="Cerrar">×</button>

    <!-- Paso 1: clave -->
    <section class="ed-paso" id="paso-clave">
      <h2 id="ed-titulo">Editar mi perfil</h2>
      <p class="ed-ayuda">Ingresa tu clave para editar tu página.</p>
      <form id="form-clave">
        <input type="password" id="input-clave" placeholder="Clave" autocomplete="current-password" required />
        <button type="submit" class="ed-primario" id="btn-entrar">Entrar</button>
      </form>
      <p class="ed-nota" id="nota-lenta" hidden>
        Conectando con el servidor, un momento...
      </p>
    </section>

    <!-- Paso 2: cambio obligatorio de clave -->
    <section class="ed-paso" id="paso-nueva-clave" hidden>
      <h2 id="titulo-clave">Crea tu clave</h2>
      <p class="ed-ayuda" id="ayuda-clave">
        La clave que te dimos es fácil de adivinar porque parte de tu nombre.
        Elige una propia de al menos 8 caracteres.
      </p>
      <form id="form-nueva-clave">
        <input type="password" id="input-nueva" placeholder="Nueva clave" autocomplete="new-password" minlength="8" required />
        <input type="password" id="input-nueva2" placeholder="Repite la clave" autocomplete="new-password" minlength="8" required />
        <button type="submit" class="ed-primario">Guardar clave</button>
      </form>
    </section>

    <!-- Paso 3: edicion -->
    <section class="ed-paso" id="paso-editor" hidden>
      <h2>Mi perfil</h2>

      <div class="ed-foto">
        <img id="ed-preview" alt="" hidden />
        <div class="ed-preview-vacio" id="ed-preview-vacio">Sin foto</div>
        <div>
          <label class="ed-secundario" for="input-foto">Cambiar foto</label>
          <input type="file" id="input-foto" accept="image/*" hidden />
          <p class="ed-nota">Se recorta cuadrada y se comprime automáticamente.</p>
        </div>
      </div>

      <label class="ed-campo">
        <span>Nombre</span>
        <input type="text" id="ed-name" maxlength="60" required />
      </label>

      <label class="ed-campo">
        <span>Cargo o profesión</span>
        <input type="text" id="ed-role" maxlength="80" placeholder="Ingeniero en Sistemas" />
      </label>

      <label class="ed-campo">
        <span>Descripción</span>
        <textarea id="ed-tagline" maxlength="300" rows="3" placeholder="Una o dos frases sobre lo que haces."></textarea>
      </label>

      <label class="ed-campo">
        <span>Pie de tarjeta</span>
        <input type="text" id="ed-footer" maxlength="80" placeholder="INGENIERÍA · INNOVACIÓN" />
      </label>

      <label class="ed-campo">
        <span>Estilo</span>
        <select id="ed-theme">
          {TEMAS.map((t) => <option value={t.id}>{t.nombre} — {t.descripcion}</option>)}
        </select>
      </label>

      <div class="ed-campo">
        <span>Mis servicios <small>(máximo 8)</small></span>
        <p class="ed-nota">Lo que ofreces. Aparecen en una cuadrícula en tu tarjeta.</p>
        <div id="ed-servicios"></div>
        <button type="button" class="ed-secundario" id="btn-agregar-servicio">+ Agregar servicio</button>
      </div>

      <div class="ed-campo">
        <span>Horario de atención <small>(opcional)</small></span>
        <label class="ed-interruptor">
          <input type="checkbox" id="ed-usar-horario" />
          <span>Mostrar mi horario en la tarjeta</span>
        </label>
        <div id="ed-horario" hidden></div>
      </div>

      <div class="ed-campo">
        <span>Mis enlaces <small>(máximo 8)</small></span>
        <div id="ed-enlaces"></div>
        <button type="button" class="ed-secundario" id="btn-agregar-enlace">+ Agregar enlace</button>
      </div>

      <div class="ed-acciones">
        <button type="button" class="ed-primario" id="btn-guardar">Guardar cambios</button>
        <button type="button" class="ed-texto" id="btn-cambiar-clave">Cambiar mi clave</button>
      </div>

      <p class="ed-cupo" id="ed-cupo" hidden></p>
    </section>

    <p class="ed-mensaje" id="ed-mensaje" hidden></p>
  </div>
</div>

<template id="tpl-enlace">
  <div class="ed-enlace">
    <select class="ed-enlace-tipo">
      {tipos.map(([id, t]) => <option value={id}>{t.nombre}</option>)}
    </select>
    <input type="text" class="ed-enlace-label" placeholder="Texto del botón" maxlength="40" />
    <input type="text" class="ed-enlace-sublabel" placeholder="Texto pequeño (opcional)" maxlength="60" />
    <input type="text" class="ed-enlace-url" placeholder="https://..." maxlength="500" />
    <button type="button" class="ed-quitar" aria-label="Quitar enlace">×</button>
  </div>
</template>

<style>
  /* Varios elementos de aqui declaran `display`, que gana por especificidad
     sobre la regla `[hidden]` del navegador. Sin esto el panel se mostraria
     siempre, incluso a los visitantes. */
  [hidden] { display: none !important; }

  /* Paleta clara del panel. Se declara aqui y no en :root para no pisar las
     variables del tema de la tarjeta que hay debajo. */
  .ed-overlay {
    --ed-fondo: #ffffff;
    --ed-borde: #e2e8f2;
    --ed-campo: #fbfcfe;
    --ed-campo-borde: #cfd8e6;
    --ed-apagado-fondo: #eef2f8;
    --ed-texto: #16233a;
    --ed-apagado: #566374;
    --ed-acento: #2563eb;

    position: fixed;
    inset: 0;
    z-index: 100;
    background: rgba(12, 20, 34, 0.55);
    backdrop-filter: blur(4px);
    display: grid;
    place-items: center;
    padding: 16px;
    overflow-y: auto;
    font-family: 'Poppins', system-ui, sans-serif;
  }

  .ed-modal {
    position: relative;
    width: 100%;
    max-width: 520px;
    max-height: 90vh;
    overflow-y: auto;
    background: var(--ed-fondo);
    color: var(--ed-texto);
    border: 1px solid var(--ed-borde);
    border-radius: 18px;
    padding: 28px 26px;
    box-shadow: 0 24px 60px rgba(12, 20, 34, 0.28);
  }

  .ed-modal h2 { font-size: 1.25rem; margin-bottom: 6px; }
  .ed-ayuda { font-size: 0.85rem; color: var(--ed-apagado); margin-bottom: 18px; line-height: 1.5; }
  .ed-nota { font-size: 0.75rem; color: var(--ed-apagado); margin-top: 6px; line-height: 1.45; }

  .ed-cerrar {
    position: absolute; top: 12px; right: 14px;
    background: none; border: none; color: var(--ed-apagado);
    font-size: 1.6rem; line-height: 1; cursor: pointer;
  }
  .ed-cerrar:hover { color: var(--ed-texto); }

  .ed-modal input[type='text'],
  .ed-modal input[type='password'],
  .ed-modal textarea,
  .ed-modal select {
    width: 100%;
    padding: 10px 12px;
    border-radius: 10px;
    border: 1px solid var(--ed-campo-borde);
    background: var(--ed-campo);
    color: var(--ed-texto);
    font: inherit;
    font-size: 0.9rem;
  }
  .ed-modal textarea { resize: vertical; }
  .ed-modal input::placeholder, .ed-modal textarea::placeholder { color: #9aa8bd; }
  .ed-modal input:focus, .ed-modal textarea:focus, .ed-modal select:focus {
    outline: 2px solid var(--ed-acento); outline-offset: 1px;
  }
  .ed-modal select option { background: var(--ed-fondo); }

  #form-clave, #form-nueva-clave { display: flex; flex-direction: column; gap: 10px; }

  .ed-campo { display: block; margin-bottom: 16px; }
  .ed-campo > span {
    display: block; font-size: 0.78rem; font-weight: 600;
    text-transform: uppercase; letter-spacing: 0.06em;
    color: var(--ed-apagado); margin-bottom: 6px;
  }
  .ed-campo small { text-transform: none; letter-spacing: 0; font-weight: 400; }

  .ed-interruptor {
    display: flex; align-items: center; gap: 8px;
    font-size: 0.85rem; color: var(--ed-texto); cursor: pointer;
    margin-bottom: 10px;
  }
  .ed-interruptor input { width: auto !important; }

  #ed-horario { --hor-borde: var(--ed-borde); }
  #ed-servicios { --srv-fondo: #f4f7fb; --srv-borde: var(--ed-borde); }

  .ed-primario {
    padding: 11px 18px; border: none; border-radius: 10px;
    background: var(--ed-acento); color: #fff; font: inherit; font-weight: 600;
    font-size: 0.9rem; cursor: pointer;
  }
  .ed-primario:hover { background: #1d4ed8; }
  .ed-primario:disabled { opacity: 0.55; cursor: progress; }

  .ed-secundario {
    display: inline-block;
    padding: 8px 14px; border-radius: 9px; cursor: pointer;
    border: 1px solid var(--ed-campo-borde);
    background: #ffffff;
    color: var(--ed-texto); font-size: 0.82rem; font-weight: 500;
  }
  .ed-secundario:hover { background: var(--ed-apagado-fondo); }

  .ed-texto {
    background: none; border: none; color: var(--ed-apagado);
    font: inherit; font-size: 0.82rem; cursor: pointer; text-decoration: underline;
  }
  .ed-texto:hover { color: var(--ed-texto); }

  .ed-foto { display: flex; align-items: center; gap: 16px; margin-bottom: 20px; }
  .ed-foto img, .ed-preview-vacio {
    width: 72px; height: 72px; border-radius: 50%;
    object-fit: cover; flex: 0 0 72px;
    border: 2px solid var(--ed-borde);
  }
  .ed-preview-vacio {
    display: grid; place-items: center;
    font-size: 0.7rem; color: var(--ed-apagado);
    background: var(--ed-apagado-fondo);
  }

  .ed-enlace {
    display: grid;
    grid-template-columns: 1fr 1fr auto;
    gap: 8px;
    padding: 12px;
    margin-bottom: 10px;
    border-radius: 12px;
    background: #f4f7fb;
    border: 1px solid var(--ed-borde);
  }
  /* La X va siempre en la esquina superior derecha de su tarjeta. */
  .ed-enlace .ed-enlace-tipo     { grid-column: 1; grid-row: 1; }
  .ed-enlace .ed-enlace-label    { grid-column: 2; grid-row: 1; }
  .ed-enlace .ed-quitar          { grid-column: 3; grid-row: 1; align-self: start; }
  .ed-enlace .ed-enlace-sublabel { grid-column: 1 / -1; grid-row: 2; }
  .ed-enlace .ed-enlace-url      { grid-column: 1 / -1; grid-row: 3; }

  .ed-quitar {
    background: none; border: none; color: #b3261e;
    font-size: 1.25rem; line-height: 1; cursor: pointer;
    padding: 2px 4px; border-radius: 6px; opacity: 0.8;
  }
  .ed-quitar:hover { opacity: 1; background: rgba(179, 38, 30, 0.09); }

  .ed-acciones {
    display: flex; align-items: center; justify-content: space-between;
    gap: 12px; margin-top: 22px; flex-wrap: wrap;
  }

  /* Solo se avisa cuando de verdad importa: si quedan pocos cambios. */
  .ed-cupo {
    margin-top: 12px;
    font-size: 0.76rem;
    color: var(--ed-apagado);
    text-align: center;
  }
  .ed-cupo.pocos { color: #b45309; font-weight: 500; }

  .ed-mensaje {
    margin-top: 16px; padding: 11px 14px; border-radius: 10px;
    font-size: 0.85rem; line-height: 1.5;
  }
  .ed-mensaje.ok { background: #e8f6ee; color: #15803d; border: 1px solid #c2e6d1; }
  .ed-mensaje.error { background: #fdeaea; color: #b3261e; border: 1px solid #f6c9c9; }
  .ed-mensaje.info { background: #eaf1fe; color: #1d4ed8; border: 1px solid #c9dbfb; }

  @media (max-width: 480px) {
    .ed-modal { padding: 24px 18px; }

    /* Igual que en el alta: apilado, para que la lista de tipo tenga
       ancho suficiente para leerse. */
    .ed-enlace { grid-template-columns: 1fr auto; gap: 7px; }
    .ed-enlace .ed-enlace-tipo     { grid-column: 1; grid-row: 1; }
    .ed-enlace .ed-quitar          { grid-column: 2; grid-row: 1; }
    .ed-enlace .ed-enlace-label    { grid-column: 1 / -1; grid-row: 2; }
    .ed-enlace .ed-enlace-sublabel { grid-column: 1 / -1; grid-row: 3; }
    .ed-enlace .ed-enlace-url      { grid-column: 1 / -1; grid-row: 4; }
  }
</style>

<script type="application/json" id="ed-datos" set:html={JSON.stringify({ API_URL, perfilInicial: semilla })}></script>

<script>
  import { comprimirFoto } from '../lib/foto.js';
  import { activarOjo } from '../lib/ojo.js';
  import { montarEditorHorario } from '../lib/horarios.js';
  import { ajustarCampoUrl } from '../lib/enlaces.js';
  import { montarEditorServicios, MAX_SERVICIOS } from '../lib/servicios.js';

  (() => {
    const $ = (id) => document.getElementById(id);
    const { API_URL, perfilInicial } = JSON.parse($('ed-datos').textContent);
    const overlay = $('ed-overlay');
    const mensaje = $('ed-mensaje');
    let token = null;
    let editorHorario = null;
    let editorServicios = null;

    for (const id of ['input-clave', 'input-nueva', 'input-nueva2']) activarOjo(id);
    let perfil = JSON.parse(JSON.stringify(perfilInicial));

    const mostrar = (texto, tipo = 'info') => {
      mensaje.textContent = texto;
      mensaje.className = `ed-mensaje ${tipo}`;
      mensaje.hidden = false;
    };
    const limpiarMensaje = () => { mensaje.hidden = true; };

    const paso = (id) => {
      for (const s of document.querySelectorAll('.ed-paso')) s.hidden = s.id !== id;
    };

    async function api(ruta, opciones = {}) {
      const res = await fetch(`${API_URL}${ruta}`, {
        ...opciones,
        headers: {
          'Content-Type': 'application/json',
          ...(token ? { Authorization: `Bearer ${token}` } : {}),
          ...opciones.headers,
        },
      });
      const datos = await res.json().catch(() => ({}));
      if (!res.ok) throw new Error(datos.error || `Error ${res.status}`);
      return datos;
    }

    /* ------------------------------------------------ abrir / cerrar */

    $('abrir-editor').addEventListener('click', () => {
      overlay.hidden = false;
      limpiarMensaje();
      paso(token ? 'paso-editor' : 'paso-clave');
      if (!token) $('input-clave').focus();
    });

    const cerrar = () => { overlay.hidden = true; };
    $('ed-cerrar').addEventListener('click', cerrar);
    overlay.addEventListener('click', (e) => { if (e.target === overlay) cerrar(); });
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && !overlay.hidden) cerrar(); });

    /* ------------------------------------------------------- ingreso */

    $('form-clave').addEventListener('submit', async (e) => {
      e.preventDefault();
      const boton = $('btn-entrar');
      boton.disabled = true;
      limpiarMensaje();

      // Si la respuesta tarda, avisar en vez de dejar la pantalla muerta.
      const avisoLento = setTimeout(() => { $('nota-lenta').hidden = false; }, 4000);

      try {
        const datos = await api('/api/auth/login', {
          method: 'POST',
          body: JSON.stringify({ slug: perfil.slug, password: $('input-clave').value }),
        });
        token = datos.token;
        perfil = { ...perfil, ...datos.profile };
        $('input-clave').value = '';
        if (perfil.mustChangePassword) textoDeClave(true);
        paso(perfil.mustChangePassword ? 'paso-nueva-clave' : 'paso-editor');
        if (!perfil.mustChangePassword) llenarFormulario();
      } catch (err) {
        mostrar(err.message, 'error');
      } finally {
        clearTimeout(avisoLento);
        $('nota-lenta').hidden = true;
        boton.disabled = false;
      }
    });

    $('form-nueva-clave').addEventListener('submit', async (e) => {
      e.preventDefault();
      const a = $('input-nueva').value;
      const b = $('input-nueva2').value;
      if (a !== b) return mostrar('Las claves no coinciden.', 'error');

      try {
        await api('/api/auth/password', { method: 'POST', body: JSON.stringify({ newPassword: a }) });
        perfil.mustChangePassword = false;
        $('input-nueva').value = '';
        $('input-nueva2').value = '';
        limpiarMensaje();
        paso('paso-editor');
        llenarFormulario();
      } catch (err) {
        mostrar(err.message, 'error');
      }
    });

    /**
     * El mismo paso sirve para dos situaciones distintas, y el texto tiene que
     * decir la verdad en las dos: una cosa es obligar a cambiar una clave que
     * generaste tu, y otra que el cliente la cambie porque quiere.
     */
    function textoDeClave(obligatorio) {
      $('titulo-clave').textContent = obligatorio ? 'Crea tu clave' : 'Cambiar mi clave';
      $('ayuda-clave').textContent = obligatorio
        ? 'La clave que te dimos es fácil de adivinar porque parte de tu nombre. Elige una propia de al menos 8 caracteres.'
        : 'Escribe tu clave nueva, de al menos 8 caracteres.';
    }

    $('btn-cambiar-clave').addEventListener('click', () => {
      limpiarMensaje();
      textoDeClave(false);
      paso('paso-nueva-clave');
    });

    /* ---------------------------------------------------- formulario */

    function filaEnlace(enlace) {
      const datos = enlace || { type: 'whatsapp', label: '', sublabel: '', url: '' };
      const fila = $('tpl-enlace').content.firstElementChild.cloneNode(true);
      fila.querySelector('.ed-enlace-tipo').value = datos.type;
      fila.querySelector('.ed-enlace-label').value = datos.label;
      fila.querySelector('.ed-enlace-sublabel').value = datos.sublabel || '';
      const campoUrl = fila.querySelector('.ed-enlace-url');
      const selectTipo = fila.querySelector('.ed-enlace-tipo');
      campoUrl.value = datos.url;
      ajustarCampoUrl(campoUrl, datos.type);
      selectTipo.addEventListener('change', () => ajustarCampoUrl(campoUrl, selectTipo.value));

      fila.querySelector('.ed-quitar').addEventListener('click', () => fila.remove());
      return fila;
    }

    function llenarFormulario() {
      $('ed-name').value = perfil.name || '';
      $('ed-role').value = perfil.role || '';
      $('ed-tagline').value = perfil.tagline || '';
      $('ed-footer').value = perfil.footer || '';
      $('ed-theme').value = perfil.theme || 'oro-tech';

      const contenedor = $('ed-enlaces');
      contenedor.innerHTML = '';
      for (const enlace of perfil.links || []) contenedor.appendChild(filaEnlace(enlace));

      editorServicios = montarEditorServicios($('ed-servicios'));
      editorServicios.cargar(perfil.services);

      const usar = $('ed-usar-horario');
      usar.checked = Boolean(perfil.hours);
      editorHorario = montarEditorHorario($('ed-horario'), perfil.hours);
      $('ed-horario').hidden = !usar.checked;

      mostrarCupo();

      if (perfil.hasPhoto) {
        const v = perfil.photoUpdatedAt ? `?v=${Date.parse(perfil.photoUpdatedAt)}` : '';
        $('ed-preview').src = `/fotos/${perfil.slug}.webp${v}`;
        $('ed-preview').hidden = false;
        $('ed-preview-vacio').hidden = true;
      }
    }

    $('btn-agregar-enlace').addEventListener('click', () => {
      const contenedor = $('ed-enlaces');
      if (contenedor.children.length >= 8) return mostrar('Máximo 8 enlaces.', 'error');
      contenedor.appendChild(filaEnlace());
    });

    $('btn-agregar-servicio').addEventListener('click', () => {
      if (!editorServicios?.agregar()) mostrar(`Máximo ${MAX_SERVICIOS} servicios.`, 'error');
    });

    $('ed-usar-horario').addEventListener('change', (e) => {
      $('ed-horario').hidden = !e.target.checked;
    });

    // Vista previa del tema en vivo, sin recargar la pagina.
    $('ed-theme').addEventListener('change', (e) => {
      document.documentElement.dataset.tema = e.target.value;
    });

    /**
     * Aviso de cuantos cambios quedan hoy. Se calla mientras sobren: solo
     * estorbaria. Aparece cuando quedan cinco o menos.
     */
    function pintarCupo(restantes, limite) {
      const aviso = $('ed-cupo');
      if (restantes === null || restantes === undefined || restantes > 5) {
        aviso.hidden = true;
        return;
      }
      aviso.textContent = restantes > 0
        ? `Te ${restantes === 1 ? 'queda 1 cambio' : `quedan ${restantes} cambios`} hoy${limite ? ` de ${limite}` : ''}.`
        : 'Ya usaste todos tus cambios de hoy. Podrás seguir mañana.';
      aviso.className = `ed-cupo ${restantes <= 2 ? 'pocos' : ''}`.trim();
      aviso.hidden = false;
    }

    async function mostrarCupo() {
      try {
        const cupo = await api(`/api/profiles/${perfil.slug}/cupo`);
        pintarCupo(cupo.restantes, cupo.limite);
      } catch {
        // No es crítico: si falla, simplemente no se muestra el aviso.
      }
    }

    /* ---------------------------------------------------------- foto */

    $('input-foto').addEventListener('change', async (e) => {
      const archivo = e.target.files && e.target.files[0];
      if (!archivo) return;
      limpiarMensaje();

      try {
        const dataUrl = await comprimirFoto(archivo);
        var respuestaFoto = await api(`/api/profiles/${perfil.slug}/photo`, {
          method: 'PUT',
          body: JSON.stringify({ dataUrl }),
        });
        $('ed-preview').src = dataUrl;
        $('ed-preview').hidden = false;
        $('ed-preview-vacio').hidden = true;
        perfil.hasPhoto = true;
        pintarCupo(respuestaFoto?.restantes);
        mostrar('Foto guardada. Ya se ve en tu página.', 'ok');
      } catch (err) {
        mostrar(err.message, 'error');
      } finally {
        e.target.value = '';
      }
    });

    /* -------------------------------------------------------- guardar */

    $('btn-guardar').addEventListener('click', async () => {
      const boton = $('btn-guardar');
      limpiarMensaje();

      const links = [...document.querySelectorAll('.ed-enlace')]
        .map((fila) => ({
          type: fila.querySelector('.ed-enlace-tipo').value,
          label: fila.querySelector('.ed-enlace-label').value.trim(),
          sublabel: fila.querySelector('.ed-enlace-sublabel').value.trim(),
          url: fila.querySelector('.ed-enlace-url').value.trim(),
        }))
        .filter((enlace) => enlace.label && enlace.url);

      const cambios = {
        services: editorServicios?.leer() ?? [],
        hours: $('ed-usar-horario').checked ? editorHorario?.leer() ?? null : null,
        name: $('ed-name').value.trim(),
        role: $('ed-role').value.trim(),
        tagline: $('ed-tagline').value.trim(),
        footer: $('ed-footer').value.trim(),
        theme: $('ed-theme').value,
        links,
      };

      if (!cambios.name) return mostrar('El nombre no puede quedar vacío.', 'error');

      boton.disabled = true;
      try {
        const datos = await api(`/api/profiles/${perfil.slug}`, {
          method: 'PUT',
          body: JSON.stringify(cambios),
        });
        perfil = { ...perfil, ...datos.profile };
        pintarCupo(datos.restantes);
        mostrar(
          'Listo, tus cambios ya están en tu página. Puedes cerrar esta ventana.',
          'ok'
        );
      } catch (err) {
        mostrar(err.message, 'error');
      } finally {
        boton.disabled = false;
      }
    });
  })();
</script>
