---
import '../themes/base.css';
import '../themes/oro-tech.css';
import '../themes/navy-pro.css';
import '../themes/marfil-oro.css';
import '../themes/rosa-glam.css';
import { temaValido } from '../lib/temas.js';
import { iconoDe, FLECHA } from '../lib/enlaces.js';
import { DIAS, textoDelDia } from '../lib/horarios.js';
import { iconoServicio } from '../lib/servicios.js';
import PanelEdicion from '../components/PanelEdicion.astro';

const { perfil } = Astro.props;
const tema = temaValido(perfil.theme);

const inicial = perfil.name.trim().charAt(0).toUpperCase();
const [primerNombre, ...resto] = perfil.name.trim().split(/\s+/);
const apellidos = resto.join(' ');

// Open Graph: es lo que ve WhatsApp o LinkedIn cuando alguien comparte el link.
// La foto se sirve con cache largo, asi que la URL lleva la marca de la
// ultima actualizacion: sin eso, quien ya visito la pagina seguiria viendo la
// foto anterior durante horas aunque el cliente la hubiera cambiado.
const version = perfil.photoUpdatedAt ? `?v=${Date.parse(perfil.photoUpdatedAt)}` : '';
const urlFoto = `/fotos/${perfil.slug}.webp${version}`;

const urlCanonica = new URL(`/${perfil.slug}`, Astro.site).href;

// Siempre hay vista previa: sin foto se dibuja la inicial sobre el tema, igual
// que en la tarjeta. Se versiona con updatedAt y no con la fecha de la foto,
// porque en la imagen tambien va el nombre, el cargo y el lema: la respuesta
// se cachea un año, asi que sin esto un cambio de cargo no se veria al
// compartir. Un perfil sin foto no tiene fecha de foto que usar.
const imagenOG =
  `${new URL(`/og/${perfil.slug}.jpg`, Astro.site).href}?v=${Date.parse(perfil.updatedAt)}`;
const descripcion = perfil.tagline || perfil.role || `Tarjeta de presentacion de ${perfil.name}`;
---

<!doctype html>
<html lang="es" data-tema={tema}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{perfil.name}{perfil.role ? ` · ${perfil.role}` : ''}</title>
    <meta name="description" content={descripcion} />
    <link rel="canonical" href={urlCanonica} />

    <meta property="og:type" content="profile" />
    <meta property="og:title" content={perfil.name} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:url" content={urlCanonica} />
    <meta property="og:image" content={imagenOG} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;600;700&family=Poppins:wght@300;400;600;700&display=swap"
      rel="stylesheet"
    />
  </head>

  <body>
    <div class="fondo-decor" aria-hidden="true"></div>

    <!-- El body centra a su unico hijo. La envoltura mantiene ese centrado
         ahora que debajo de la tarjeta va el enlace de edicion: sin ella el
         enlace seria un segundo hijo del flex y saldria al costado. -->
    <div class="envoltura">
      <main class="tarjeta" id="tarjeta">
      <header class="tarjeta__cabecera">
        <div class="avatar">
          {
            perfil.hasPhoto ? (
              <img src={urlFoto} alt={perfil.name} width="132" height="132" id="foto-perfil" />
            ) : (
              <div class="inicial" id="foto-perfil" aria-hidden="true">{inicial}</div>
            )
          }
        </div>

        <h1 class="nombre" id="campo-name">
          <span class="destacado">{primerNombre}</span>{apellidos && ` ${apellidos}`}
        </h1>

        <div class="separador" aria-hidden="true"></div>

        {perfil.role && <p class="cargo" id="campo-role">{perfil.role}</p>}
      </header>

      <div class="tarjeta__cuerpo">
      {perfil.tagline && <p class="tagline" id="campo-tagline">{perfil.tagline}</p>}

      {
        perfil.services?.length > 0 && (
          <section class="servicios">
            <h2 class="bloque-titulo">Servicios</h2>
            <div class="servicios__rejilla">
              {
                perfil.services.map((s) => (
                  <div class="servicio">
                    <span class="servicio__icono" set:html={iconoServicio(s.icon)} />
                    <span class="servicio__texto">{s.label}</span>
                  </div>
                ))
              }
            </div>
          </section>
        )
      }

      <div class="enlaces" id="lista-enlaces">
        {
          perfil.links.map((enlace) => (
            <a
              class={`enlace enlace--${enlace.type}`}
              href={enlace.url}
              target={enlace.url.startsWith('http') ? '_blank' : null}
              rel={enlace.url.startsWith('http') ? 'noopener noreferrer' : null}
            >
              <span class="enlace__icono" set:html={iconoDe(enlace.type)} />
              <span class="enlace__texto">
                <strong>{enlace.label}</strong>
                {enlace.sublabel && <span>{enlace.sublabel}</span>}
              </span>
              <span class="enlace__flecha" set:html={FLECHA} />
            </a>
          ))
        }
      </div>

      {
        perfil.hours && (
          <section class="horario" data-horario={JSON.stringify(perfil.hours)}>
            <button type="button" class="horario__cabecera" id="horario-toggle" aria-expanded="false" aria-controls="horario-semana">
              <span class="horario__estado" id="horario-estado">
                <span class="horario__punto" aria-hidden="true" />
                <span id="horario-texto">Horario de atención</span>
              </span>
              <span class="horario__flecha" aria-hidden="true">▾</span>
            </button>

            <div class="horario__semana" id="horario-semana" hidden>
              {
                DIAS.map((nombre, i) => (
                  <div class="horario__fila" data-dia={i}>
                    <span>{nombre}</span>
                    <span>{textoDelDia(perfil.hours.days[i])}</span>
                  </div>
                ))
              }
            </div>
          </section>
        )
      }

      {perfil.footer && <p class="pie" id="campo-footer">{perfil.footer}</p>}
      </div>
      </main>

      <PanelEdicion perfil={perfil} />
    </div>

    <script>
      // El estado se calcula en el navegador: la pagina es estatica y quedaria
      // congelada con el "abierto" que hubiera al momento del build.
      import { estadoAhora, ahoraEnZona } from '../lib/horarios.js';

      const seccion = document.querySelector('.horario');
      if (seccion) {
        const horario = JSON.parse(seccion.dataset.horario);
        const estado = estadoAhora(horario);

        if (estado) {
          document.getElementById('horario-texto').textContent = estado.texto;
          seccion.classList.add(estado.abierto ? 'esta-abierto' : 'esta-cerrado');
        }

        const { dia } = ahoraEnZona(horario.tz);
        seccion.querySelector(`.horario__fila[data-dia="${dia}"]`)?.classList.add('es-hoy');

        const boton = document.getElementById('horario-toggle');
        const semana = document.getElementById('horario-semana');
        boton.addEventListener('click', () => {
          const abierto = !semana.hidden;
          semana.hidden = abierto;
          boton.setAttribute('aria-expanded', String(!abierto));
          seccion.classList.toggle('desplegado', !abierto);
        });
      }
    </script>
  </body>
</html>
