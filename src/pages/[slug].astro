---
import Perfil from '../layouts/Perfil.astro';
import { obtenerPerfil } from '../lib/api.js';

// Se pide solo este perfil, cuando alguien abre su tarjeta. Antes se
// generaban todas de golpe en el build.
const { slug } = Astro.params;
const perfil = await obtenerPerfil(slug);

if (!perfil || !perfil.published) {
  return Astro.rewrite('/404');
}

// La tarjeta puede cachearse un rato en Nginx: cambia poco y asi una racha de
// visitas no llega al proceso. `must-revalidate` evita servirla rancia cuando
// el cliente acaba de editar.
Astro.response.headers.set('Cache-Control', 'public, max-age=60, must-revalidate');
---

<Perfil perfil={perfil} />
