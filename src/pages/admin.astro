---
// Esta pagina no depende de ningun perfil: se genera una sola vez en el
// build y Nginx la sirve como archivo, sin pasar por el proceso.
export const prerender = true;
/**
 * Panel del dueño del sistema.
 *
 * Es una pagina publica del sitio, pero sin la clave de administrador no hace
 * nada: cada peticion la lleva en la cabecera y la API la exige. La clave se
 * guarda en sessionStorage, asi que se olvida al cerrar la pestaña.
 */
import { PLANTILLAS } from '../lib/plantillas.js';

// Vacio = mismo dominio: Nginx manda /api al backend, asi que el navegador
// llama a rutas relativas y no hay CORS que configurar. Solo hace falta poner
// la URL completa si algun dia la API vive en otro dominio.
const API_URL = (import.meta.env.PUBLIC_API_URL || '').replace(/\/$/, '');
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Panel</title>
    <meta name="robots" content="noindex, nofollow" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>

  <body data-api={API_URL}>
    <!-- Entrar -->
    <section id="pantalla-clave" class="centrado">
      <div class="caja">
        <h1>Panel</h1>
        <form id="form-clave">
          <input type="password" id="clave" placeholder="Clave de administrador" autocomplete="current-password" required />
          <button type="submit" class="principal">Entrar</button>
        </form>
        <p class="mensaje" id="msg-clave" hidden></p>
      </div>
    </section>

    <!-- Panel -->
    <main id="panel" hidden>
      <header class="barra">
        <h1>Panel</h1>
        <button type="button" class="texto" id="btn-salir">Salir</button>
      </header>

      <section class="bloque">
        <h2>Invitar a un cliente</h2>
        <p class="apagado">
          Genera un enlace de un solo uso para que el cliente cree su propia tarjeta.
        </p>

        <div class="formulario-invitar">
          <label class="campo">
            <span>Para quién es</span>
            <input type="text" id="i-nota" placeholder="Juan Pérez, barbería El Corte..." maxlength="120" />
          </label>

          <label class="campo">
            <span>Plantilla sugerida</span>
            <select id="i-plantilla">
              <option value="">Que la elija el cliente</option>
              {PLANTILLAS.map((p) => <option value={p.id}>{p.nombre}</option>)}
            </select>
          </label>

          <label class="campo estrecho">
            <span>Días</span>
            <input type="number" id="i-dias" value="14" min="1" max="90" />
          </label>

          <label class="campo ancho">
            <span>Dirección de la página <small>(opcional)</small></span>
            <div class="fila-slug">
              <span class="prefijo" id="prefijo"></span>
              <input type="text" id="i-slug" placeholder="dr-lopez" maxlength="40" autocapitalize="none" spellcheck="false" />
            </div>
            <small class="pista" id="pista-slug">
              Fíjala si vas a imprimir el QR o grabar la tarjeta NFC antes de que
              el cliente llene el formulario. Queda apartada y él no podrá cambiarla.
            </small>
          </label>
        </div>

        <button type="button" class="principal" id="btn-generar">Generar enlace</button>

        <div class="resultado" id="resultado" hidden>
          <p class="apagado pequeno">Enlace listo. Sirve una sola vez:</p>
          <code id="enlace-nuevo"></code>
          <div class="acciones">
            <button type="button" class="secundario" id="btn-copiar">Copiar</button>
            <a class="secundario" id="btn-whatsapp" target="_blank" rel="noopener">Enviar por WhatsApp</a>
          </div>

          <div id="bloque-tarjeta" hidden>
            <hr class="separador" />
            <p class="apagado pequeno">
              Dirección definitiva. <strong>Esta</strong> es la que va al QR y a la tarjeta NFC:
            </p>
            <code id="url-tarjeta"></code>
            <button type="button" class="secundario" id="btn-copiar-tarjeta">Copiar dirección</button>
          </div>
        </div>
      </section>

      <section class="bloque">
        <div class="titulo-fila">
          <h2>Invitaciones <span class="conteo" id="conteo-inv"></span></h2>
          <button type="button" class="texto" id="btn-recargar-inv">Actualizar</button>
        </div>

        <div class="filtros">
          <input type="search" id="buscar-inv" placeholder="Buscar por nombre o dirección..." autocomplete="off" />
          <div class="chips" id="chips-inv">
            <button type="button" class="chip activo" data-estado="">Todas</button>
            <button type="button" class="chip" data-estado="pendiente">Pendientes</button>
            <button type="button" class="chip" data-estado="usada">Usadas</button>
            <button type="button" class="chip" data-estado="caducada">Caducadas</button>
          </div>
        </div>

        <div id="lista-invitaciones" class="lista"></div>
        <button type="button" class="mas" id="mas-inv" hidden></button>
      </section>

      <section class="bloque">
        <div class="titulo-fila">
          <h2>Perfiles <span class="conteo" id="conteo-perf"></span></h2>
          <button type="button" class="texto" id="btn-recargar-perf">Actualizar</button>
        </div>

        <div class="filtros">
          <input type="search" id="buscar-perf" placeholder="Buscar por nombre, dirección o cargo..." autocomplete="off" />
          <div class="chips" id="chips-perf">
            <button type="button" class="chip activo" data-estado="">Todos</button>
            <button type="button" class="chip" data-estado="publicado">En línea</button>
            <button type="button" class="chip" data-estado="oculto">Ocultos</button>
          </div>
        </div>

        <div id="lista-perfiles" class="lista"></div>
        <button type="button" class="mas" id="mas-perf" hidden></button>
      </section>

      <p class="mensaje" id="msg-panel" hidden></p>
    </main>

    <!--
      is:global a proposito: las tarjetas de invitaciones y perfiles las crea
      JavaScript con createElement, y esos nodos no llevan el atributo de
      scope de Astro, asi que con estilos scopados no les aplicaba ninguna
      regla. Esta pagina no comparte layout, de modo que su CSS solo viaja
      con ella.
    -->
    <style is:global>
      :root {
        --fondo: #0a1020;
        --tarjeta: #131a2e;
        --borde: rgba(255, 255, 255, 0.10);
        --texto: #e8edf7;
        --apagado: #94a3bd;
        --acento: #5b8cff;
        --ok: #4ec98a;
        --alerta: #e8b64c;
        --error: #ff8080;
      }

      /* Sin `padding: 0` en el selector universal: Astro lo compila a
         `[data-astro-cid-...]`, que gana en especificidad a `body` y le
         borraria el margen lateral en el movil. */
      *, *::before, *::after { margin: 0; box-sizing: border-box; }

      body {
        font-family: 'Poppins', system-ui, sans-serif;
        background: var(--fondo);
        color: var(--texto);
        min-height: 100vh;
        padding: 28px 20px 60px;
      }

      main, .centrado { max-width: 720px; margin: 0 auto; }
      .centrado { display: grid; place-items: center; min-height: 80vh; }
      .caja { width: 100%; max-width: 360px; text-align: center; }

      h1 { font-size: 1.5rem; font-weight: 700; }
      h2 { font-size: 1.05rem; font-weight: 600; }
      .apagado { color: var(--apagado); font-size: 0.88rem; line-height: 1.6; margin-top: 6px; }
      .pequeno { font-size: 0.8rem; }

      .barra {
        display: flex; align-items: center; justify-content: space-between;
        margin-bottom: 22px;
      }

      .bloque {
        background: var(--tarjeta);
        border: 1px solid var(--borde);
        border-radius: 16px;
        padding: 22px 20px;
        margin-bottom: 16px;
      }

      .titulo-fila { display: flex; align-items: center; justify-content: space-between; }

      .conteo {
        font-size: 0.78rem; font-weight: 500; color: var(--apagado);
        margin-left: 4px;
      }

      .filtros { margin-top: 14px; display: flex; flex-direction: column; gap: 10px; }

      input[type='search'] {
        width: 100%; padding: 10px 12px;
        border-radius: 10px;
        border: 1px solid var(--borde);
        background: rgba(255, 255, 255, 0.04);
        color: var(--texto);
        font: inherit; font-size: 0.88rem;
      }
      input[type='search']::-webkit-search-cancel-button { filter: invert(0.6); cursor: pointer; }

      .chips { display: flex; gap: 6px; flex-wrap: wrap; }

      .chip {
        padding: 5px 12px;
        border-radius: 20px;
        border: 1px solid rgba(255, 255, 255, 0.12);
        background: transparent;
        color: var(--apagado);
        font: inherit; font-size: 0.78rem; cursor: pointer;
        transition: background 0.16s ease, color 0.16s ease, border-color 0.16s ease;
      }
      .chip:hover { color: var(--texto); border-color: rgba(255, 255, 255, 0.24); }
      .chip.activo {
        background: rgba(91, 140, 255, 0.16);
        border-color: rgba(91, 140, 255, 0.34);
        color: #bcd0ff;
      }

      .mas {
        width: 100%; margin-top: 10px; padding: 10px;
        border-radius: 10px;
        border: 1px dashed rgba(255, 255, 255, 0.16);
        background: transparent;
        color: var(--apagado);
        font: inherit; font-size: 0.83rem; cursor: pointer;
      }
      .mas:hover { color: var(--texto); border-color: rgba(255, 255, 255, 0.3); }

      .formulario-invitar {
        display: grid;
        grid-template-columns: 1fr 1fr 90px;
        gap: 12px;
        margin: 16px 0;
      }
      .campo.ancho { grid-column: 1 / -1; }

      .fila-slug { display: flex; align-items: stretch; }
      .prefijo {
        display: flex; align-items: center;
        padding: 0 4px 0 12px;
        border: 1px solid var(--borde); border-right: none;
        border-radius: 10px 0 0 10px;
        background: rgba(255, 255, 255, 0.02);
        color: var(--apagado); font-size: 0.82rem; white-space: nowrap;
      }
      .fila-slug input { border-radius: 0 10px 10px 0; }

      .pista { display: block; color: var(--apagado); font-size: 0.75rem; line-height: 1.5; margin-top: 6px; }
      .pista.error { color: var(--error); }

      .campo > span {
        display: block; font-size: 0.75rem; font-weight: 600;
        text-transform: uppercase; letter-spacing: 0.05em;
        color: var(--apagado); margin-bottom: 6px;
      }

      input, select {
        width: 100%; padding: 10px 12px;
        border-radius: 10px;
        border: 1px solid var(--borde);
        background: rgba(255, 255, 255, 0.04);
        color: var(--texto);
        font: inherit; font-size: 0.9rem;
      }
      input:focus, select:focus { outline: 2px solid var(--acento); outline-offset: 1px; }
      select option { background: var(--tarjeta); }

      #form-clave { display: flex; flex-direction: column; gap: 10px; margin-top: 18px; }

      .principal {
        padding: 11px 18px; border: none; border-radius: 10px;
        background: var(--acento); color: #fff;
        font: inherit; font-weight: 600; font-size: 0.9rem; cursor: pointer;
      }
      .principal:hover { background: #4a7cf5; }
      .principal:disabled { opacity: 0.55; cursor: progress; }

      .secundario {
        display: inline-block;
        padding: 8px 14px; border-radius: 9px; cursor: pointer;
        border: 1px solid rgba(255, 255, 255, 0.16);
        background: rgba(255, 255, 255, 0.04);
        color: var(--texto); font: inherit; font-size: 0.8rem;
        text-decoration: none;
      }
      .secundario:hover { background: rgba(255, 255, 255, 0.09); }

      .texto {
        background: none; border: none; color: var(--apagado);
        font: inherit; font-size: 0.82rem; cursor: pointer; text-decoration: underline;
      }
      .texto:hover { color: var(--texto); }

      .resultado {
        margin-top: 16px; padding: 14px;
        border-radius: 12px;
        background: rgba(91, 140, 255, 0.10);
        border: 1px solid rgba(91, 140, 255, 0.28);
      }
      .separador { border: none; border-top: 1px solid var(--borde); margin: 14px 0; }

      .resultado code {
        display: block; margin: 8px 0 12px;
        font-size: 0.8rem; word-break: break-all; color: #bcd0ff;
      }
      .acciones { display: flex; gap: 8px; flex-wrap: wrap; }

      .lista { margin-top: 16px; display: flex; flex-direction: column; gap: 10px; }

      .item {
        display: grid;
        grid-template-columns: auto 1fr auto;
        grid-template-areas:
          'sello datos estado'
          '.     acciones acciones';
        align-items: center;
        gap: 4px 13px;
        padding: 13px 15px;
        border-radius: 13px;
        background: rgba(255, 255, 255, 0.035);
        border: 1px solid rgba(255, 255, 255, 0.08);
        transition: border-color 0.18s ease, background 0.18s ease;
      }
      .item:hover { background: rgba(255, 255, 255, 0.055); border-color: rgba(255, 255, 255, 0.14); }

      /* Circulo con la inicial: distingue las filas de un vistazo. */
      .item-sello {
        grid-area: sello;
        width: 38px; height: 38px;
        display: grid; place-items: center;
        border-radius: 11px;
        font-size: 0.95rem; font-weight: 600;
        background: rgba(91, 140, 255, 0.16);
        color: #a8c2ff;
      }
      .item-sello.apagada { background: rgba(255, 255, 255, 0.06); color: var(--apagado); }
      .item-sello.hecha { background: rgba(78, 201, 138, 0.15); color: var(--ok); }

      .item-datos { grid-area: datos; min-width: 0; }
      .item-datos strong {
        display: block; font-size: 0.92rem; font-weight: 600;
        overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
      }
      .item-datos small {
        display: block; color: var(--apagado); font-size: 0.77rem;
        margin-top: 2px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
      }

      .item-acciones {
        grid-area: acciones;
        display: flex; gap: 6px; flex-wrap: wrap;
        margin-top: 10px;
      }

      /* ------------------------------------------------ botones de accion */

      .accion {
        display: inline-flex; align-items: center; gap: 6px;
        padding: 6px 11px;
        border-radius: 9px;
        border: 1px solid rgba(255, 255, 255, 0.13);
        background: rgba(255, 255, 255, 0.045);
        color: var(--texto);
        font: inherit; font-size: 0.79rem; font-weight: 500;
        text-decoration: none; cursor: pointer; white-space: nowrap;
        transition: background 0.16s ease, border-color 0.16s ease, color 0.16s ease;
      }
      .accion:hover { background: rgba(255, 255, 255, 0.1); border-color: rgba(255, 255, 255, 0.22); }

      /* Borrar es definitivo y ademas libera la direccion. Va en rojo y de
         ultimo, para que no se pulse por inercia al ir a "Clave". */
      .accion.peligro { color: #fca5a5; border-color: rgba(220, 38, 38, 0.35); }
      .accion.peligro:hover {
        background: rgba(220, 38, 38, 0.16);
        border-color: rgba(220, 38, 38, 0.55);
      }
      .accion:focus-visible { outline: 2px solid var(--acento); outline-offset: 1px; }
      .accion svg { width: 14px; height: 14px; flex: 0 0 14px; opacity: 0.8; }

      .accion.principal {
        background: rgba(91, 140, 255, 0.16);
        border-color: rgba(91, 140, 255, 0.34);
        color: #bcd0ff;
      }
      .accion.principal:hover { background: rgba(91, 140, 255, 0.26); }

      .accion.peligro { color: #ffa8a8; border-color: rgba(255, 123, 123, 0.24); }
      .accion.peligro:hover { background: rgba(255, 123, 123, 0.14); border-color: rgba(255, 123, 123, 0.42); }

      .accion.hecho { background: rgba(78, 201, 138, 0.18); border-color: rgba(78, 201, 138, 0.38); color: #8fe3b4; }

      /* ------------------------------------------------------- etiquetas */

      .etiqueta {
        grid-area: estado;
        display: inline-flex; align-items: center; gap: 6px;
        font-size: 0.68rem; font-weight: 600;
        text-transform: uppercase; letter-spacing: 0.05em;
        padding: 4px 10px; border-radius: 20px;
        white-space: nowrap;
      }
      .etiqueta::before {
        content: ''; width: 6px; height: 6px; border-radius: 50%;
        background: currentColor;
      }
      .etiqueta.pendiente { background: rgba(91, 140, 255, 0.16); color: #a8c2ff; }
      .etiqueta.usada { background: rgba(78, 201, 138, 0.14); color: #7fd9a8; }
      .etiqueta.caducada { background: rgba(255, 255, 255, 0.06); color: var(--apagado); }
      .etiqueta.oculto { background: rgba(232, 182, 76, 0.16); color: var(--alerta); }
      .etiqueta.publicado { background: rgba(78, 201, 138, 0.14); color: #7fd9a8; }

      .vacio {
        color: var(--apagado); font-size: 0.85rem;
        padding: 18px 0; text-align: center;
        border: 1px dashed rgba(255, 255, 255, 0.1);
        border-radius: 11px;
      }

      @media (max-width: 480px) {
        .item {
          grid-template-columns: auto 1fr;
          grid-template-areas:
            'sello datos'
            'estado estado'
            'acciones acciones';
          gap: 4px 12px;
        }
        .etiqueta { justify-self: start; margin-top: 8px; }
        .item-acciones { margin-top: 8px; }
        .accion { flex: 1; justify-content: center; }
      }

      .mensaje { margin-top: 14px; padding: 11px 14px; border-radius: 10px; font-size: 0.85rem; }
      .mensaje.error { background: rgba(220, 70, 70, 0.16); color: var(--error); }
      .mensaje.ok { background: rgba(78, 201, 138, 0.16); color: var(--ok); }

      [hidden] { display: none !important; }

      @media (max-width: 560px) {
        .formulario-invitar { grid-template-columns: 1fr; }
      }

      @media (max-width: 480px) {
        body { padding: 22px 20px 48px; }
        .bloque { padding: 18px 16px; border-radius: 14px; }
        .item { padding: 12px; }
      }
    </style>

    <script>
      import { activarOjo } from '../lib/ojo.js';

      const $ = (id) => document.getElementById(id);
      const API = document.body.dataset.api;
      const LLAVE = 'perfiles-admin-key';

      activarOjo('clave');

      let clave = sessionStorage.getItem(LLAVE) || null;

      // Con muchos clientes la lista se vuelve inmanejable: se filtra y se
      // muestra por tandas en vez de volcarlo todo de golpe.
      const POR_TANDA = 10;

      const datos = {
        inv: { todas: [], texto: '', estado: '', visibles: POR_TANDA },
        perf: { todos: [], texto: '', estado: '', visibles: POR_TANDA },
      };

      const sinAcentos = (t) =>
        String(t || '').normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase();

      async function api(ruta, opciones = {}) {
        const res = await fetch(`${API}${ruta}`, {
          ...opciones,
          headers: {
            'Content-Type': 'application/json',
            'x-admin-key': clave || '',
            ...opciones.headers,
          },
        });
        const datos = await res.json().catch(() => ({}));
        if (!res.ok) throw new Error(datos.error || `Error ${res.status}`);
        return datos;
      }

      const avisar = (texto, tipo = 'error', donde = 'msg-panel') => {
        $(donde).textContent = texto;
        $(donde).className = `mensaje ${tipo}`;
        $(donde).hidden = false;
        if (tipo === 'ok') setTimeout(() => { $(donde).hidden = true; }, 4000);
      };

      /* ------------------------------------------------------- iconos */

      const ICONO = {
        copiar: '<rect x="9" y="9" width="12" height="12" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/>',
        whatsapp: '<path d="M12 21.5a9.5 9.5 0 0 1-4.8-1.3L2.5 21.5l1.3-4.7A9.5 9.5 0 1 1 12 21.5Z"/><path d="M8.6 8.4c.2-.5.4-.5.6-.5h.5c.2 0 .4 0 .6.5l.8 1.9c.1.2 0 .4-.1.5l-.5.6c-.2.2-.3.3-.1.6a7.4 7.4 0 0 0 3.4 3c.3.1.5.1.7-.1l.7-.8c.2-.2.4-.2.6-.1l1.8.9c.3.1.4.3.4.5a2 2 0 0 1-1.4 1.6 3.3 3.3 0 0 1-2.6-.2 11 11 0 0 1-5.5-5 3.7 3.7 0 0 1 .1-3.4Z"/>',
        ver: '<path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7-10-7-10-7Z"/><circle cx="12" cy="12" r="3"/>',
        ojo_cerrado: '<path d="M17.9 17.9A10.1 10.1 0 0 1 12 19c-6.4 0-10-7-10-7a18.4 18.4 0 0 1 5.1-5.9M9.9 4.2A9.1 9.1 0 0 1 12 4c6.4 0 10 7 10 7a18.5 18.5 0 0 1-2.2 3.2m-6.7-1.1a3 3 0 1 1-4.2-4.2"/><path d="M2 2l20 20"/>',
        publicar: '<path d="M12 5v14M5 12h14"/>',
        reiniciar: '<path d="M3 12a9 9 0 1 0 3-6.7L3 8"/><path d="M3 3v5h5"/>',
        /* Un candado se reconoce mejor que una llave a 14 px. */
        llave: '<rect x="4" y="10.5" width="16" height="10.5" rx="2"/><path d="M8 10.5V7a4 4 0 0 1 8 0v3.5"/>',
        basura: '<path d="M4 7h16"/><path d="M10 11v6M14 11v6"/><path d="M6 7l1 13h10l1-13"/><path d="M9 7V4h6v3"/>',
        anular: '<path d="M4 7h16M10 11v6m4-6v6M5 7l1 13h12l1-13M9 7V4h6v3"/>',
      };

      const svg = (contenido) =>
        `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${contenido}</svg>`;

      /** Boton de accion con icono. `variante`: principal, peligro o vacio. */
      function accion({ texto, icono, variante = '', href = null, onClick = null }) {
        const el = document.createElement(href ? 'a' : 'button');
        if (href) {
          el.href = href;
          el.target = '_blank';
          el.rel = 'noopener';
        } else {
          el.type = 'button';
        }
        el.className = `accion ${variante}`.trim();
        el.innerHTML = svg(ICONO[icono]);
        el.append(document.createTextNode(texto));
        // Se pasa el propio boton: dentro de un handler async, currentTarget
        // ya es null en cuanto se cede el control con el primer await.
        if (onClick) el.addEventListener('click', () => onClick(el));
        return el;
      }

      /** Confirmacion breve dentro del propio boton. */
      function confirmarEnBoton(boton, textoOk = 'Copiado') {
        const original = boton.textContent;
        const iconoOriginal = boton.querySelector('svg')?.outerHTML || '';
        boton.classList.add('hecho');
        boton.textContent = textoOk;
        setTimeout(() => {
          boton.classList.remove('hecho');
          boton.innerHTML = iconoOriginal;
          boton.append(document.createTextNode(original));
        }, 1800);
      }

      const inicialDe = (texto) => (texto || '?').trim().charAt(0).toUpperCase();

      const fecha = (iso) =>
        new Date(iso).toLocaleDateString('es-GT', { day: 'numeric', month: 'short', year: 'numeric' });

      /* ------------------------------------------------------- entrar */

      async function entrar() {
        // Cualquier ruta de admin sirve para validar la clave.
        await api('/api/invitations');
        $('pantalla-clave').hidden = true;
        $('panel').hidden = false;
        await Promise.all([cargarInvitaciones(), cargarPerfiles()]);
      }

      $('form-clave').addEventListener('submit', async (e) => {
        e.preventDefault();
        clave = $('clave').value;
        try {
          await entrar();
          sessionStorage.setItem(LLAVE, clave);
          $('clave').value = '';
        } catch (err) {
          clave = null;
          sessionStorage.removeItem(LLAVE);
          avisar(err.message, 'error', 'msg-clave');
        }
      });

      $('btn-salir').addEventListener('click', () => {
        sessionStorage.removeItem(LLAVE);
        location.reload();
      });

      // Si ya se habia entrado en esta pestaña, no volver a pedir la clave.
      if (clave) entrar().catch(() => { sessionStorage.removeItem(LLAVE); clave = null; });

      /* -------------------------------------------------- invitaciones */

      const enlaceDe = (token) => `${location.origin}/crear?i=${token}`;

      $('prefijo').textContent = `${location.host}/`;

      $('i-slug').addEventListener('input', () => {
        $('i-slug').value = $('i-slug').value.toLowerCase().replace(/[^a-z0-9-]/g, '');
      });

      $('btn-generar').addEventListener('click', async () => {
        const boton = $('btn-generar');
        boton.disabled = true;
        try {
          const { invitacion } = await api('/api/invitations', {
            method: 'POST',
            body: JSON.stringify({
              nota: $('i-nota').value.trim(),
              plantilla: $('i-plantilla').value || null,
              slug: $('i-slug').value.trim() || null,
              dias: Number($('i-dias').value) || 14,
            }),
          });

          const url = enlaceDe(invitacion.token);
          $('enlace-nuevo').textContent = url;
          $('btn-whatsapp').href =
            `https://wa.me/?text=${encodeURIComponent(`Aquí puedes crear tu tarjeta digital: ${url}`)}`;

          // La direccion definitiva: es la que va al QR y a la tarjeta NFC.
          if (invitacion.slug) {
            $('url-tarjeta').textContent = `${location.origin}/${invitacion.slug}`;
            $('bloque-tarjeta').hidden = false;
          } else {
            $('bloque-tarjeta').hidden = true;
          }

          $('resultado').hidden = false;
          $('i-nota').value = '';
          $('i-slug').value = '';
          await cargarInvitaciones();
        } catch (err) {
          avisar(err.message);
        } finally {
          boton.disabled = false;
        }
      });

      $('btn-copiar-tarjeta').addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText($('url-tarjeta').textContent);
          $('btn-copiar-tarjeta').textContent = 'Copiado';
          setTimeout(() => { $('btn-copiar-tarjeta').textContent = 'Copiar dirección'; }, 2000);
        } catch {
          avisar('No se pudo copiar. Selecciona la dirección a mano.');
        }
      });

      $('btn-copiar').addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText($('enlace-nuevo').textContent);
          $('btn-copiar').textContent = 'Copiado';
          setTimeout(() => { $('btn-copiar').textContent = 'Copiar'; }, 2000);
        } catch {
          avisar('No se pudo copiar. Selecciona el enlace a mano.');
        }
      });

      function estadoInvitacion(inv) {
        if (inv.usedAt) return { clase: 'usada', texto: 'usada' };
        if (new Date(inv.expiresAt) < new Date()) return { clase: 'caducada', texto: 'caducada' };
        return { clase: 'pendiente', texto: 'pendiente' };
      }

      async function cargarInvitaciones() {
        try {
          datos.inv.todas = await api('/api/invitations');
          datos.inv.visibles = POR_TANDA;
          pintarInvitaciones();
        } catch (err) {
          $('lista-invitaciones').innerHTML = `<p class="vacio">No se pudieron cargar: ${err.message}</p>`;
        }
      }

      function pintarInvitaciones() {
        const lista = $('lista-invitaciones');
        const { todas, texto, estado, visibles } = datos.inv;

        const filtradas = todas.filter((inv) => {
          if (estado && estadoInvitacion(inv).clase !== estado) return false;
          if (!texto) return true;
          return sinAcentos(`${inv.nota} ${inv.slug || ''} ${inv.usedBySlug || ''}`).includes(texto);
        });

        $('conteo-inv').textContent = todas.length
          ? filtradas.length === todas.length ? `(${todas.length})` : `(${filtradas.length} de ${todas.length})`
          : '';

        lista.innerHTML = '';

        if (!todas.length) {
          lista.innerHTML = '<p class="vacio">Todavía no has generado ninguna.</p>';
          $('mas-inv').hidden = true;
          return;
        }
        if (!filtradas.length) {
          lista.innerHTML = '<p class="vacio">Ninguna coincide con la búsqueda.</p>';
          $('mas-inv').hidden = true;
          return;
        }

        const restantes = filtradas.length - visibles;
        $('mas-inv').hidden = restantes <= 0;
        if (restantes > 0) {
          $('mas-inv').textContent = `Mostrar ${Math.min(restantes, POR_TANDA)} más de ${restantes}`;
        }

        {
          const invitaciones = filtradas.slice(0, visibles);
          for (const inv of invitaciones) {
            const estado = estadoInvitacion(inv);
            const item = document.createElement('div');
            item.className = 'item';

            const sello = document.createElement('span');
            sello.className = `item-sello ${estado.clase === 'usada' ? 'hecha' : estado.clase === 'caducada' ? 'apagada' : ''}`.trim();
            sello.textContent = inicialDe(inv.nota);
            sello.setAttribute('aria-hidden', 'true');

            const campos = document.createElement('div');
            campos.className = 'item-datos';
            const titulo = document.createElement('strong');
            titulo.textContent = inv.nota || '(sin nota)';
            const detalle = document.createElement('small');
            detalle.textContent = inv.usedAt
              ? `creó /${inv.usedBySlug} el ${fecha(inv.usedAt)}`
              : inv.slug
                ? `/${inv.slug} apartada · caduca el ${fecha(inv.expiresAt)}`
                : `caduca el ${fecha(inv.expiresAt)}`;
            campos.append(titulo, detalle);

            const etiqueta = document.createElement('span');
            etiqueta.className = `etiqueta ${estado.clase}`;
            etiqueta.textContent = estado.texto;

            const acciones = document.createElement('div');
            acciones.className = 'item-acciones';

            if (estado.clase === 'pendiente') {
              const copiar = accion({
                texto: 'Copiar enlace', icono: 'copiar', variante: 'principal',
                onClick: async () => {
                  try {
                    await navigator.clipboard.writeText(enlaceDe(inv.token));
                    confirmarEnBoton(copiar);
                  } catch {
                    avisar('No se pudo copiar. Genera el enlace de nuevo para verlo.');
                  }
                },
              });
              acciones.appendChild(copiar);

              acciones.appendChild(accion({
                texto: 'WhatsApp', icono: 'whatsapp',
                href: `https://wa.me/?text=${encodeURIComponent(`Aquí puedes crear tu tarjeta digital: ${enlaceDe(inv.token)}`)}`,
              }));
            }

            if (!inv.usedAt) {
              acciones.appendChild(accion({
                texto: 'Anular', icono: 'anular', variante: 'peligro',
                onClick: async () => {
                  if (!confirm('¿Anular esta invitación? El enlace dejará de servir.')) return;
                  try {
                    await api(`/api/invitations/${inv.token}`, { method: 'DELETE' });
                    await cargarInvitaciones();
                  } catch (err) {
                    avisar(err.message);
                  }
                },
              }));
            }

            item.append(sello, campos, etiqueta);
            if (acciones.children.length) item.appendChild(acciones);
            lista.appendChild(item);
          }
        }
      }

      $('btn-recargar-inv').addEventListener('click', cargarInvitaciones);

      $('mas-inv').addEventListener('click', () => {
        datos.inv.visibles += POR_TANDA;
        pintarInvitaciones();
      });

      $('buscar-inv').addEventListener('input', (e) => {
        datos.inv.texto = sinAcentos(e.target.value.trim());
        datos.inv.visibles = POR_TANDA;
        pintarInvitaciones();
      });

      for (const chip of $('chips-inv').querySelectorAll('.chip')) {
        chip.addEventListener('click', () => {
          $('chips-inv').querySelectorAll('.chip').forEach((c) => c.classList.remove('activo'));
          chip.classList.add('activo');
          datos.inv.estado = chip.dataset.estado;
          datos.inv.visibles = POR_TANDA;
          pintarInvitaciones();
        });
      }

      /* ------------------------------------------------------ perfiles */

      async function cargarPerfiles() {
        try {
          datos.perf.todos = await api('/api/profiles/todos');
          datos.perf.visibles = POR_TANDA;
          pintarPerfiles();
        } catch (err) {
          $('lista-perfiles').innerHTML = `<p class="vacio">No se pudieron cargar: ${err.message}</p>`;
        }
      }

      function pintarPerfiles() {
        const lista = $('lista-perfiles');
        const { todos, texto, estado, visibles } = datos.perf;

        const filtrados = todos.filter((p) => {
          if (estado === 'publicado' && !p.published) return false;
          if (estado === 'oculto' && p.published) return false;
          if (!texto) return true;
          return sinAcentos(`${p.name} ${p.slug} ${p.role || ''}`).includes(texto);
        });

        $('conteo-perf').textContent = todos.length
          ? filtrados.length === todos.length ? `(${todos.length})` : `(${filtrados.length} de ${todos.length})`
          : '';

        lista.innerHTML = '';

        if (!todos.length) {
          lista.innerHTML = '<p class="vacio">Todavía no hay perfiles.</p>';
          $('mas-perf').hidden = true;
          return;
        }
        if (!filtrados.length) {
          lista.innerHTML = '<p class="vacio">Ninguno coincide con la búsqueda.</p>';
          $('mas-perf').hidden = true;
          return;
        }

        const restantes = filtrados.length - visibles;
        $('mas-perf').hidden = restantes <= 0;
        if (restantes > 0) {
          $('mas-perf').textContent = `Mostrar ${Math.min(restantes, POR_TANDA)} más de ${restantes}`;
        }

        {
          const perfiles = filtrados.slice(0, visibles);
          for (const p of perfiles) {
            const item = document.createElement('div');
            item.className = 'item';

            const sello = document.createElement('span');
            sello.className = `item-sello ${p.published ? '' : 'apagada'}`.trim();
            sello.textContent = inicialDe(p.name);
            sello.setAttribute('aria-hidden', 'true');

            const campos = document.createElement('div');
            campos.className = 'item-datos';
            const titulo = document.createElement('strong');
            titulo.textContent = p.name;
            const detalle = document.createElement('small');
            detalle.textContent = `/${p.slug} · ${p.role || 'sin cargo'}`;
            campos.append(titulo, detalle);

            const etiqueta = document.createElement('span');
            etiqueta.className = `etiqueta ${p.published ? 'publicado' : 'oculto'}`;
            etiqueta.textContent = p.published ? 'en línea' : 'oculto';

            const acciones = document.createElement('div');
            acciones.className = 'item-acciones';

            acciones.appendChild(accion({
              texto: 'Ver', icono: 'ver', href: `/${p.slug}`,
            }));

            acciones.appendChild(accion({
              texto: p.published ? 'Ocultar' : 'Publicar',
              icono: p.published ? 'ojo_cerrado' : 'publicar',
              onClick: async () => {
                try {
                  await api(`/api/profiles/${p.slug}/published`, {
                    method: 'PATCH',
                    body: JSON.stringify({ published: !p.published }),
                  });
                  await cargarPerfiles();
                  avisar('Listo. El sitio se regenera en un par de minutos.', 'ok');
                } catch (err) {
                  avisar(err.message);
                }
              },
            }));

            acciones.appendChild(accion({
              texto: 'Dar cambios', icono: 'reiniciar',
              onClick: async (boton) => {
                try {
                  await api(`/api/profiles/${p.slug}/reiniciar-cambios`, { method: 'POST' });
                  confirmarEnBoton(boton, 'Hecho');
                  avisar(`${p.name} vuelve a tener sus cambios de hoy.`, 'ok');
                } catch (err) {
                  avisar(err.message);
                }
              },
            }));

            acciones.appendChild(accion({
              texto: 'Clave', icono: 'llave',
              onClick: async () => {
                const nueva = prompt(`Nueva clave para ${p.name} (mínimo 8 caracteres):`);
                if (!nueva) return;
                if (nueva.length < 8) return avisar('La clave debe tener al menos 8 caracteres.');
                try {
                  await api(`/api/profiles/${p.slug}/reset-password`, {
                    method: 'POST',
                    body: JSON.stringify({ password: nueva }),
                  });
                  avisar('Clave cambiada. Entrégasela y el panel le pedirá cambiarla.', 'ok');
                } catch (err) {
                  avisar(err.message);
                }
              },
            }));

            acciones.appendChild(accion({
              texto: 'Borrar', icono: 'basura', variante: 'peligro',
              onClick: async () => {
                // Se pide escribir la dirección, no un "aceptar". Borrar es
                // definitivo y además libera la dirección: si esa persona
                // repartió códigos QR o tarjetas NFC impresas, otro cliente
                // puede tomarla después y el plástico apuntaría a un extraño.
                // Para retirar una tarjeta sin ese riesgo está "Ocultar".
                const escrito = prompt(
                  `Vas a BORRAR a ${p.name} y liberar la dirección /${p.slug}.\n\n` +
                    'Es definitivo: se pierden sus datos y su foto, y se cancela su ' +
                    'cobro mensual.\n\n' +
                    'Si solo quieres quitarla de circulación, cancela y usa "Ocultar".\n\n' +
                    `Escribe ${p.slug} para confirmar:`
                );
                if (escrito === null) return;
                if (escrito.trim().toLowerCase() !== p.slug) {
                  return avisar('No coincide. No se borró nada.');
                }

                try {
                  const r = await api(`/api/profiles/${p.slug}`, { method: 'DELETE' });
                  await cargarPerfiles();
                  avisar(
                    r.cobroCancelado
                      ? `${p.name} borrado y su cobro mensual cancelado.`
                      : `${p.name} borrado. No tenía cobro activo que cancelar.`,
                    'ok'
                  );
                } catch (err) {
                  avisar(err.message);
                }
              },
            }));

            item.append(sello, campos, etiqueta, acciones);
            lista.appendChild(item);
          }
        }
      }

      $('btn-recargar-perf').addEventListener('click', cargarPerfiles);

      $('mas-perf').addEventListener('click', () => {
        datos.perf.visibles += POR_TANDA;
        pintarPerfiles();
      });

      $('buscar-perf').addEventListener('input', (e) => {
        datos.perf.texto = sinAcentos(e.target.value.trim());
        datos.perf.visibles = POR_TANDA;
        pintarPerfiles();
      });

      for (const chip of $('chips-perf').querySelectorAll('.chip')) {
        chip.addEventListener('click', () => {
          $('chips-perf').querySelectorAll('.chip').forEach((c) => c.classList.remove('activo'));
          chip.classList.add('activo');
          datos.perf.estado = chip.dataset.estado;
          datos.perf.visibles = POR_TANDA;
          pintarPerfiles();
        });
      }
    </script>
  </body>
</html>
