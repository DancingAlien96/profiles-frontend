---
// Esta pagina no depende de ningun perfil: se genera una sola vez en el
// build y Nginx la sirve como archivo, sin pasar por el proceso.
export const prerender = true;

// Portada comercial. NO lista los perfiles a proposito: cada cliente comparte
// su propio enlace y no tiene por que existir un directorio publico de la
// cartera. La tarjeta de ejemplo de abajo es inventada, no la de nadie.
const anio = new Date().getFullYear();

// El WhatsApp del negocio, no el de ningun cliente. wa.me lo quiere sin signos.
const WHATSAPP = '50233074483';
const SALUDO = encodeURIComponent(
  'Hola, vi la página y me interesa una tarjeta de presentación digital.'
);
const contacto = `https://wa.me/${WHATSAPP}?text=${SALUDO}`;

const urlCanonica = new URL('/', Astro.site).href;
const descripcion =
  'Tarjetas de presentación digitales para profesionales y negocios. Tu foto, ' +
  'tus contactos, tu horario y tus servicios en una sola dirección que compartes ' +
  'por WhatsApp o llevas en un código QR.';

/** Lo que incluye la tarjeta. El icono va en linea: son seis, no vale una fuente. */
const incluye = [
  {
    titulo: 'Tu propia dirección',
    texto: 'professionalprofiles.online/tunombre. Es tuya y no cambia nunca, así que puedes imprimirla sin miedo.',
    d: 'M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20m6.9 6h-2.9a15.7 15.7 0 0 0-1.4-3.6A8 8 0 0 1 18.9 8M12 4c.8 1.2 1.4 2.5 1.8 4h-3.6c.4-1.5 1-2.8 1.8-4M4.3 14A8 8 0 0 1 4 12c0-.7.1-1.4.3-2h3.3a16.6 16.6 0 0 0 0 4H4.3m.8 2h2.9c.3 1.3.8 2.5 1.4 3.6A8 8 0 0 1 5.1 16m2.9-8H5.1a8 8 0 0 1 4.3-3.6C8.8 5.5 8.3 6.7 8 8m4 12c-.8-1.2-1.4-2.5-1.8-4h3.6c-.4 1.5-1 2.8-1.8 4m2.2-6H9.8a14.7 14.7 0 0 1 0-4h4.4a14.7 14.7 0 0 1 0 4m.3 5.6c.6-1.1 1.1-2.3 1.4-3.6h2.9a8 8 0 0 1-4.3 3.6m1.8-5.6a16.6 16.6 0 0 0 0-4h3.3c.2.6.3 1.3.3 2s-.1 1.4-.3 2h-3.3Z',
  },
  {
    titulo: 'Todo a un toque',
    texto: 'WhatsApp, llamada, correo, redes y sitio web como botones. Nadie tiene que copiar y pegar tu número.',
    d: 'M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.2.4 2.4.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1A17 17 0 0 1 3 4c0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.3.2 2.5.6 3.6.1.4 0 .7-.2 1l-2.3 2.2Z',
  },
  {
    titulo: 'Tu horario, en vivo',
    texto: 'Un punto verde dice si estás abierto en este momento. Se calcula solo, sin que tengas que tocar nada.',
    d: 'M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20m4.2 14.2L11 13V7h1.5v5.2l4.5 2.7-.8 1.3Z',
  },
  {
    titulo: 'Lo que ofreces',
    texto: 'Hasta ocho servicios con su icono, para que se entienda a qué te dedicas sin leer un párrafo.',
    d: 'm12 17.3-6.2 3.7 1.6-7L2 9.2l7.2-.6L12 2l2.8 6.6 7.2.6-5.4 4.8 1.6 7L12 17.3Z',
  },
  {
    titulo: 'Cuatro diseños',
    texto: 'Elegimos el que va con tu profesión: técnico, salud, legal o belleza. Con tu foto y tus colores.',
    d: 'M12 22a10 10 0 0 1 0-20c5.5 0 10 4 10 9 0 3.3-2.7 6-6 6h-1.8c-.6 0-1 .4-1 1 0 .3.1.5.3.7.2.3.3.6.3.9 0 .8-.7 1.4-1.5 1.4M6.5 13a1.5 1.5 0 1 0 0-3 1.5 1.5 0 0 0 0 3m3-4a1.5 1.5 0 1 0 0-3 1.5 1.5 0 0 0 0 3m5 0a1.5 1.5 0 1 0 0-3 1.5 1.5 0 0 0 0 3m3 4a1.5 1.5 0 1 0 0-3 1.5 1.5 0 0 0 0 3Z',
  },
  {
    titulo: 'La cambias tú',
    texto: 'Entras con tu clave y editas lo que quieras. El cambio se ve al instante, sin llamar a nadie.',
    d: 'M20.7 7.0a1 1 0 0 0 0-1.4l-2.3-2.3a1 1 0 0 0-1.4 0l-1.8 1.8 3.7 3.7 1.8-1.8M3 17.2V21h3.8L17.8 10 14 6.2 3 17.2Z',
  },
];

/** Como se pone en marcha, del lado del cliente. */
const pasos = [
  {
    titulo: 'Llenas tus datos',
    texto:
      'A qué te dedicas, tu foto, tus contactos y tu horario. Eliges tu dirección y tu propia clave: nadie más la sabe.',
  },
  {
    titulo: 'Pagas los $6.99',
    texto:
      'Con tarjeta, en la pasarela. Tu dirección queda apartada desde que empiezas, para que nadie te la gane mientras tanto.',
  },
  {
    titulo: 'Tu tarjeta queda activa',
    texto:
      'En el momento, sin esperar a nadie. La compartes por WhatsApp, o la llevas impresa en un código QR o grabada en una tarjeta NFC.',
  },
];
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Tarjetas de presentación digitales | Professional Profiles</title>
    <meta name="description" content={descripcion} />
    <link rel="canonical" href={urlCanonica} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content="Tarjetas de presentación digitales" />
    <meta property="og:description" content={descripcion} />
    <meta property="og:url" content={urlCanonica} />
    <meta property="og:locale" content="es_GT" />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@600;700&family=Poppins:wght@300;400;600;700&display=swap"
      rel="stylesheet"
    />

    <style>
      /* Sin `padding: 0` en el selector universal: Astro lo compila a
         `[data-astro-cid-...]`, que gana en especificidad a `body` y le
         borraria el margen lateral en el movil. */
      *, *::before, *::after { margin: 0; box-sizing: border-box; }

      /* Las mismas variables del tema oro-tech: quien llega aqui desde la
         tarjeta de un cliente reconoce el mismo sitio. */
      :root {
        --acento: #e6c25a;
        --acento-tenue: rgba(230, 194, 90, 0.14);
        --texto: #eaf0ff;
        --suave: #9fb0d0;
        /* No es el #61708c de las tarjetas: ahi solo pinta separadores, pero
           aqui lleva texto (el pie y la nota del ejemplo) y con ese tono se
           quedaba en 3.7 de contraste, por debajo del minimo de 4.5. */
        --tenue: #7d8ca8;
        --panel: rgba(13, 27, 58, 0.55);
        --panel-borde: rgba(230, 194, 90, 0.28);
        --titulo: 'Playfair Display', Georgia, serif;
        --cuerpo: 'Poppins', system-ui, sans-serif;
      }

      html { -webkit-text-size-adjust: 100%; scroll-behavior: smooth; }

      @media (prefers-reduced-motion: reduce) {
        html { scroll-behavior: auto; }
      }

      body {
        font-family: var(--cuerpo);
        color: var(--texto);

        /* El color solido va aparte del degradado a proposito: es la red de
           seguridad. Si el degradado no llega a cubrir todo el documento, el
           fondo sigue siendo oscuro y el texto claro se lee igual; sin el,
           asoma el blanco del navegador y la pagina queda ilegible.
           Tampoco se usa background-attachment: fixed, que ademas de provocar
           justo eso, Safari en iOS lo maneja mal. */
        background-color: #050b1a;
        background-image:
          radial-gradient(1200px 800px at 15% 5%, rgba(17, 36, 80, 0.9), transparent 60%),
          radial-gradient(1000px 700px at 85% 95%, rgba(184, 144, 47, 0.10), transparent 55%),
          linear-gradient(160deg, #050b1a 0%, #0a1428 45%, #0d1b3a 100%);
        background-repeat: no-repeat;
        background-size: cover;

        min-height: 100vh;
        overflow-x: hidden;
        line-height: 1.65;
      }

      /* Rejilla de circuito, igual que en el tema. Decorativa y no clicable. */
      .decor {
        position: fixed;
        inset: 0;
        z-index: 0;
        pointer-events: none;
        background-image:
          linear-gradient(rgba(230, 194, 90, 0.05) 1px, transparent 1px),
          linear-gradient(90deg, rgba(230, 194, 90, 0.05) 1px, transparent 1px);
        background-size: 48px 48px;
        -webkit-mask-image: radial-gradient(circle at 50% 30%, #000 20%, transparent 70%);
        mask-image: radial-gradient(circle at 50% 30%, #000 20%, transparent 70%);
      }

      .envoltura {
        position: relative;
        z-index: 1;
        width: 100%;
        max-width: 1080px;
        margin: 0 auto;
        padding: 0 20px;
      }

      /* ---------------------------------------------------------- hero */

      .hero {
        display: grid;
        gap: 48px;
        align-items: center;
        padding: 64px 0 72px;
      }

      .marca {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        font-size: 0.72rem;
        letter-spacing: 0.22em;
        text-transform: uppercase;
        color: var(--acento);
        margin-bottom: 24px;
      }
      .marca::before {
        content: '';
        width: 26px;
        height: 1px;
        background: var(--acento);
      }

      h1 {
        font-family: var(--titulo);
        font-weight: 700;
        font-size: clamp(2.1rem, 7vw, 3.4rem);
        line-height: 1.12;
        letter-spacing: -0.01em;
      }
      h1 em { font-style: normal; color: var(--acento); }

      .entrada {
        margin-top: 20px;
        color: var(--suave);
        font-size: clamp(1rem, 2.4vw, 1.12rem);
        max-width: 46ch;
      }

      /* El precio va antes del boton a proposito: quien compra solo, sin
         hablar con nadie, se siente engañado si lo descubre en la pasarela. */
      .precio {
        margin-top: 26px;
        display: flex;
        flex-wrap: wrap;
        align-items: baseline;
        gap: 8px;
        font-size: 1.05rem;
        color: var(--texto);
      }
      .precio strong {
        font-family: var(--titulo);
        font-size: 2.1rem;
        font-weight: 700;
        color: var(--acento);
      }
      .precio span { font-size: 0.88rem; color: var(--suave); }

      .acciones {
        margin-top: 26px;
        display: flex;
        flex-wrap: wrap;
        gap: 14px;
      }

      .boton {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        padding: 15px 26px;
        border-radius: 14px;
        font-weight: 600;
        font-size: 0.98rem;
        text-decoration: none;
        transition: transform 0.15s ease, background 0.15s ease, border-color 0.15s ease;
      }
      .boton svg { flex-shrink: 0; }

      .boton--principal {
        background: var(--acento);
        color: #0a1428;
      }
      .boton--principal:hover { transform: translateY(-2px); background: #f0d074; }

      .boton--secundario {
        background: rgba(255, 255, 255, 0.04);
        border: 1px solid var(--panel-borde);
        color: var(--texto);
      }
      .boton--secundario:hover { background: var(--acento-tenue); }

      @media (prefers-reduced-motion: reduce) {
        .boton:hover { transform: none; }
      }

      /* El foco tiene que verse: mucha gente llega desde el movil, pero
         quien navegue con teclado no debe quedarse sin saber donde esta. */
      a:focus-visible {
        outline: 2px solid var(--acento);
        outline-offset: 3px;
      }

      .nota {
        margin-top: 18px;
        font-size: 0.84rem;
        color: var(--tenue);
      }
      .nota a { color: var(--acento); }

      /* --------------------------------------------- tarjeta de ejemplo */

      .muestra { display: flex; justify-content: center; }

      /* Replica reducida de una tarjeta real, con datos inventados: se ve lo
         que se compra sin exponer el perfil de ningun cliente. */
      .ejemplo {
        width: 100%;
        max-width: 320px;
        padding: 32px 24px 26px;
        border-radius: 22px;
        background: var(--panel);
        border: 1px solid var(--panel-borde);
        box-shadow: 0 24px 60px rgba(0, 0, 0, 0.55);
        backdrop-filter: blur(14px);
        -webkit-backdrop-filter: blur(14px);
        text-align: center;
      }

      .ejemplo__avatar {
        width: 96px;
        height: 96px;
        margin: 0 auto 18px;
        border-radius: 50%;
        display: grid;
        place-items: center;
        font-family: var(--titulo);
        font-size: 2.4rem;
        font-weight: 700;
        color: var(--acento);
        background: var(--acento-tenue);
        border: 3px solid var(--acento);
        box-shadow: 0 0 0 6px var(--acento-tenue);
      }

      .ejemplo__nombre {
        font-family: var(--titulo);
        font-size: 1.35rem;
        font-weight: 700;
        line-height: 1.25;
      }
      .ejemplo__cargo {
        margin-top: 8px;
        font-size: 0.7rem;
        letter-spacing: 0.18em;
        text-transform: uppercase;
        color: var(--acento);
      }
      .ejemplo__lema {
        margin-top: 14px;
        font-size: 0.86rem;
        color: var(--suave);
      }

      .ejemplo__estado {
        margin-top: 18px;
        display: inline-flex;
        align-items: center;
        gap: 7px;
        font-size: 0.78rem;
        color: var(--suave);
      }
      .punto {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: #4ade80;
        box-shadow: 0 0 0 3px rgba(74, 222, 128, 0.18);
      }

      .ejemplo__enlaces {
        margin-top: 20px;
        display: grid;
        gap: 9px;
      }
      .ejemplo__enlace {
        display: flex;
        align-items: center;
        gap: 11px;
        padding: 11px 14px;
        border-radius: 13px;
        background: rgba(255, 255, 255, 0.04);
        border: 1px solid rgba(230, 194, 90, 0.18);
        font-size: 0.84rem;
        text-align: left;
        color: var(--texto);
      }
      .ejemplo__enlace svg { color: var(--acento); flex-shrink: 0; }

      .pie-muestra {
        margin-top: 16px;
        text-align: center;
        font-size: 0.76rem;
        color: var(--tenue);
      }

      /* ------------------------------------------------------ secciones */

      section { padding: 56px 0; }

      .titulo-seccion {
        font-family: var(--titulo);
        font-size: clamp(1.6rem, 4.5vw, 2.15rem);
        font-weight: 600;
        text-align: center;
        line-height: 1.2;
      }
      .bajada {
        margin: 14px auto 0;
        max-width: 52ch;
        text-align: center;
        color: var(--suave);
        font-size: 0.98rem;
      }

      .rejilla {
        margin-top: 44px;
        display: grid;
        gap: 18px;
        grid-template-columns: repeat(auto-fit, minmax(258px, 1fr));
      }

      .ficha {
        padding: 26px 24px;
        border-radius: 18px;
        background: rgba(255, 255, 255, 0.025);
        border: 1px solid rgba(230, 194, 90, 0.14);
      }
      .ficha__icono {
        width: 44px;
        height: 44px;
        border-radius: 12px;
        display: grid;
        place-items: center;
        background: var(--acento-tenue);
        color: var(--acento);
        margin-bottom: 16px;
      }
      .ficha h3 {
        font-size: 1.02rem;
        font-weight: 600;
        margin-bottom: 8px;
      }
      .ficha p { color: var(--suave); font-size: 0.9rem; }

      /* ------------------------------------------------- tarjeta fisica */

      .fisica__caja { margin-top: 40px; display: grid; justify-items: center; }

      .volteo {
        /* La perspectiva va en el contenedor, no en la cara que rota: sin
           ella el giro se ve plano, como un simple cambio de imagen. */
        perspective: 1600px;
        width: 100%;
        max-width: 520px;
        /* La proporcion de las fotos. Reservarla evita que el resto de la
           pagina salte cuando la imagen termina de cargar. */
        aspect-ratio: 1100 / 733;
        padding: 0;
        border: 0;
        background: none;
        cursor: pointer;
        display: block;
      }
      .volteo:focus-visible { outline: 2px solid var(--acento); outline-offset: 8px; border-radius: 18px; }

      .volteo__interior {
        position: relative;
        display: block;
        width: 100%;
        height: 100%;
        /* Sin esto los hijos se aplanan al plano del padre y el reverso nunca
           llega a quedar detras. */
        transform-style: preserve-3d;
        transition: transform 0.75s cubic-bezier(0.22, 1, 0.36, 1);
      }

      .volteo:hover .volteo__interior,
      .volteo[aria-pressed='true'] .volteo__interior {
        transform: rotateY(180deg);
      }

      .volteo__cara {
        position: absolute;
        inset: 0;
        display: block;
        /* Oculta la cara que mira hacia atras; sin esto se verian las dos
           superpuestas y en espejo. */
        backface-visibility: hidden;
        -webkit-backface-visibility: hidden;
        border-radius: 16px;
        overflow: hidden;
        box-shadow: 0 24px 60px rgba(0, 0, 0, 0.5);
      }
      .volteo__cara--dorso { transform: rotateY(180deg); }

      .volteo__cara img {
        width: 100%;
        height: 100%;
        /* contain y no cover: una tarjeta recortada por los bordes no sirve
           para enseñar como queda impresa. */
        object-fit: contain;
        display: block;
        background: #fff;
      }

      .fisica .pista {
        margin-top: 18px;
        text-align: center;
        font-size: 0.85rem;
        color: var(--tenue);
      }

      /* Sin animacion, el giro pasa a ser un cambio directo: se sigue viendo
         el reverso, pero sin el movimiento que puede marear. */
      @media (prefers-reduced-motion: reduce) {
        .volteo__interior { transition: none; }
      }

      /* En un dispositivo tactil no hay "pasar el cursor": el hover se queda
         pegado tras tocar y la tarjeta no vuelve. Ahi manda solo el toque. */
      @media (hover: none) {
        .volteo:hover .volteo__interior { transform: none; }
        .volteo[aria-pressed='true'] .volteo__interior { transform: rotateY(180deg); }
      }

      /* ---------------------------------------------------------- pasos */

      .pasos {
        margin-top: 44px;
        display: grid;
        gap: 22px;
        grid-template-columns: repeat(auto-fit, minmax(238px, 1fr));
        counter-reset: paso;
      }
      .paso { position: relative; padding-top: 52px; }
      .paso::before {
        counter-increment: paso;
        content: counter(paso);
        position: absolute;
        top: 0;
        left: 0;
        width: 38px;
        height: 38px;
        border-radius: 50%;
        display: grid;
        place-items: center;
        font-family: var(--titulo);
        font-weight: 700;
        color: var(--acento);
        background: var(--acento-tenue);
        border: 1px solid var(--panel-borde);
      }
      .paso h3 { font-size: 1.02rem; font-weight: 600; margin-bottom: 8px; }
      .paso p { color: var(--suave); font-size: 0.9rem; }

      /* --------------------------------------------------------- cierre */

      .cierre {
        margin: 16px 0 72px;
        padding: 48px 32px;
        border-radius: 24px;
        text-align: center;
        background: var(--panel);
        border: 1px solid var(--panel-borde);
      }
      .cierre .acciones { justify-content: center; }

      footer {
        border-top: 1px solid rgba(230, 194, 90, 0.12);
        padding: 28px 0 36px;
        text-align: center;
        font-size: 0.8rem;
        color: var(--tenue);
      }

      /* ------------------------------------------------------ escritorio */

      @media (min-width: 860px) {
        .hero {
          grid-template-columns: 1.05fr 0.95fr;
          padding: 88px 0 96px;
        }
      }
    </style>
  </head>

  <body>
    <div class="decor" aria-hidden="true"></div>

    <div class="envoltura">
      <header class="hero">
        <div>
          <p class="marca">Professional Profiles</p>

          <h1>Tu tarjeta de presentación, <em>en una sola dirección</em></h1>

          <p class="entrada">
            Tu foto, tus contactos, tu horario y tus servicios en una página que
            se abre al instante. La compartes por WhatsApp o la llevas en un
            código QR. Sin aplicaciones que instalar.
          </p>

          <p class="precio">
            <strong>$6.99</strong> al mes
            <span>· sin contrato, la cancelas cuando quieras</span>
          </p>

          <div class="acciones">
            <a class="boton boton--principal" href="/crear">
              Crear mi tarjeta
              <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true">
                <path d="M12 4l-1.4 1.4L16.2 11H4v2h12.2l-5.6 5.6L12 20l8-8-8-8Z"/>
              </svg>
            </a>
            <a class="boton boton--secundario" href={contacto} target="_blank" rel="noopener">
              <svg viewBox="0 0 24 24" width="19" height="19" fill="currentColor" aria-hidden="true">
                <path d="M12 2a10 10 0 0 0-8.6 15L2 22l5.2-1.4A10 10 0 1 0 12 2m0 1.8a8.2 8.2 0 1 1-4.2 15.2l-.3-.2-3.1.8.8-3-.2-.3A8.2 8.2 0 0 1 12 3.8m-3.1 4c-.2 0-.5.1-.7.3-.3.3-.9.9-.9 2.1s.9 2.4 1 2.6c.1.2 1.7 2.7 4.3 3.7 2.1.8 2.5.7 3 .6.5-.1 1.5-.6 1.7-1.2.2-.6.2-1.2.2-1.3-.1-.1-.3-.2-.5-.3l-1.8-.9c-.3-.1-.5-.1-.6.1l-.8 1c-.2.2-.3.2-.5.1-.3-.1-1.2-.4-2.2-1.4-.8-.7-1.4-1.6-1.5-1.9-.1-.2 0-.4.1-.5l.4-.5.3-.5v-.5l-.8-1.9c-.2-.5-.4-.4-.5-.5h-.2Z"/>
              </svg>
              Tengo una duda
            </a>
          </div>

          <p class="nota">Lista en 5 minutos · Sin instalar nada</p>
        </div>

        <div class="muestra">
          <div>
            <!-- Tarjeta de ejemplo, con datos inventados. -->
            <article class="ejemplo" aria-label="Ejemplo de tarjeta">
              <div class="ejemplo__avatar" aria-hidden="true">L</div>
              <p class="ejemplo__nombre">Lucía Herrera</p>
              <p class="ejemplo__cargo">Nutricionista</p>
              <p class="ejemplo__lema">Consulta nutricional y planes personalizados</p>

              <p class="ejemplo__estado"><span class="punto" aria-hidden="true"></span> Abierto ahora</p>

              <div class="ejemplo__enlaces">
                <span class="ejemplo__enlace">
                  <svg viewBox="0 0 24 24" width="17" height="17" fill="currentColor" aria-hidden="true">
                    <path d="M12 2a10 10 0 0 0-8.6 15L2 22l5.2-1.4A10 10 0 1 0 12 2Z"/>
                  </svg>
                  WhatsApp
                </span>
                <span class="ejemplo__enlace">
                  <svg viewBox="0 0 24 24" width="17" height="17" fill="currentColor" aria-hidden="true">
                    <path d="M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.2.4 2.4.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1A17 17 0 0 1 3 4c0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.3.2 2.5.6 3.6.1.4 0 .7-.2 1l-2.3 2.2Z"/>
                  </svg>
                  Llamar
                </span>
                <span class="ejemplo__enlace">
                  <svg viewBox="0 0 24 24" width="17" height="17" fill="currentColor" aria-hidden="true">
                    <path d="M20 4H4a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V6a2 2 0 0 0-2-2m0 4-8 5-8-5V6l8 5 8-5v2Z"/>
                  </svg>
                  Correo
                </span>
              </div>
            </article>
            <p class="pie-muestra">Así se ve una tarjeta. El ejemplo es ficticio.</p>
          </div>
        </div>
      </header>

      <section id="incluye">
        <h2 class="titulo-seccion">Todo lo tuyo, en un solo enlace</h2>
        <p class="bajada">
          Una tarjeta de papel se pierde y no se puede corregir. Esta se
          actualiza cuando quieras y siempre está en el teléfono de quien la
          recibió.
        </p>

        <div class="rejilla">
          {
            incluye.map((f) => (
              <article class="ficha">
                <div class="ficha__icono" aria-hidden="true">
                  <svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor">
                    <path d={f.d} />
                  </svg>
                </div>
                <h3>{f.titulo}</h3>
                <p>{f.texto}</p>
              </article>
            ))
          }
        </div>
      </section>

      <section class="fisica">
        <h2 class="titulo-seccion">Y también en la mano</h2>
        <p class="bajada">
          La tarjeta digital vive en un enlace, pero el enlace tiene que llegar
          a alguien. Un código QR impreso o una tarjeta NFC lo hacen sin que la
          otra persona teclee nada.
        </p>

        <div class="fisica__caja">
          <!--
            El giro es un boton de verdad, no un div: se puede llegar con el
            teclado y anuncia si esta mostrando el frente o el reverso. Con el
            raton basta pasar por encima; con el dedo, tocar.
          -->
          <button
            type="button"
            class="volteo"
            id="volteo"
            aria-pressed="false"
            aria-label="Girar la tarjeta para ver el reverso"
          >
            <span class="volteo__interior">
              <span class="volteo__cara">
                <img
                  src="/muestra/tarjeta-frente.webp"
                  alt="Frente de una tarjeta impresa: nombre, especialidad, contactos y un código QR"
                  width="1100"
                  height="733"
                  loading="lazy"
                  decoding="async"
                />
              </span>
              <span class="volteo__cara volteo__cara--dorso">
                <img
                  src="/muestra/tarjeta-dorso.webp"
                  alt="Reverso de la misma tarjeta, con el logotipo"
                  width="1100"
                  height="733"
                  loading="lazy"
                  decoding="async"
                />
              </span>
            </span>
          </button>

          <p class="pista" id="pista-volteo">Toca la tarjeta para verle el reverso</p>
        </div>
      </section>

      <section>
        <h2 class="titulo-seccion">Cómo se pone en marcha</h2>
        <p class="bajada">Tres pasos, y la tarjeta queda lista el mismo día.</p>

        <div class="pasos">
          {
            pasos.map((p) => (
              <article class="paso">
                <h3>{p.titulo}</h3>
                <p>{p.texto}</p>
              </article>
            ))
          }
        </div>
      </section>

      <section class="cierre">
        <h2 class="titulo-seccion">¿Empezamos?</h2>
        <p class="bajada">
          Llenas tus datos, eliges tu dirección y pagas. Tu tarjeta queda activa
          en el momento, sin esperar a que nadie te la prepare.
        </p>
        <div class="acciones">
          <a class="boton boton--principal" href="/crear">
            Crear mi tarjeta por $6.99 al mes
            <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true">
              <path d="M12 4l-1.4 1.4L16.2 11H4v2h12.2l-5.6 5.6L12 20l8-8-8-8Z"/>
            </svg>
          </a>
        </div>
        <p class="nota" style="margin-top: 20px;">
          ¿Prefieres preguntar antes?
          <a href={contacto} target="_blank" rel="noopener">Escríbeme por WhatsApp</a>
        </p>
      </section>

      <footer>
        <p>Professional Profiles &middot; Guatemala</p>
        <p>&copy; {anio}</p>
      </footer>
    </div>

    <script is:inline>
      // El giro por toque. Con raton lo hace el CSS al pasar por encima; esto
      // cubre el movil y el teclado, y mantiene aria-pressed al dia para quien
      // navegue con lector de pantalla.
      (() => {
        const boton = document.getElementById('volteo');
        const pista = document.getElementById('pista-volteo');
        if (!boton) return;

        // El texto de la pista depende del dispositivo, no del tamaño de la
        // pantalla: hay portatiles con pantalla tactil y tablets con raton.
        if (pista && matchMedia('(hover: hover)').matches) {
          pista.textContent = 'Pasa el cursor por la tarjeta para verle el reverso';
        }

        boton.addEventListener('click', () => {
          const girada = boton.getAttribute('aria-pressed') === 'true';
          boton.setAttribute('aria-pressed', String(!girada));
          boton.setAttribute(
            'aria-label',
            girada ? 'Girar la tarjeta para ver el reverso' : 'Girar la tarjeta para ver el frente'
          );
        });
      })();
    </script>
  </body>
</html>
