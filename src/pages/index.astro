---
// Portada. No lista los perfiles a proposito: cada cliente comparte su propio
// enlace y no tiene por que aparecer un directorio publico de la cartera.
const anio = new Date().getFullYear();
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Tarjetas de presentación digitales</title>
    <meta name="description" content="Tarjetas de presentación digitales para profesionales y negocios." />
    <meta name="robots" content="noindex" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600;700&display=swap" rel="stylesheet" />
    <style>
      * { margin: 0; padding: 0; box-sizing: border-box; }
      body {
        font-family: 'Poppins', system-ui, sans-serif;
        min-height: 100vh;
        display: grid;
        place-items: center;
        padding: 40px 20px;
        text-align: center;
        color: #eaf0ff;
        background: linear-gradient(160deg, #050b1a 0%, #0a1428 50%, #0d1b3a 100%);
      }
      h1 { font-size: clamp(1.8rem, 6vw, 2.6rem); font-weight: 700; line-height: 1.2; }
      p { margin-top: 16px; color: #9fb0d0; max-width: 460px; line-height: 1.65; }
      .marca { color: #e6c25a; }
      footer { margin-top: 40px; font-size: 0.75rem; color: #61708c; letter-spacing: 0.15em; }
    </style>
  </head>
  <body>
    <main>
      <h1>Tarjetas de presentación <span class="marca">digitales</span></h1>
      <p>
        Cada cliente tiene su propia dirección. Si buscas un perfil en particular,
        usa el enlace que te compartieron.
      </p>
      <footer>&copy; {anio}</footer>
    </main>
  </body>
</html>
